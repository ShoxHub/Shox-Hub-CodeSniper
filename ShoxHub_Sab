-- LAYOUT (Skalierung, Minimieren, im Bild halten)
local function clampRoot(s)
	local v = viewport()
	local p = U.root.Position
	U.root.Position = UDim2.fromOffset(
		math.clamp(p.X.Offset, -(W * s) + 70, v.X - 70),
		math.clamp(p.Y.Offset, 0, v.Y - 40)
	)
end

local function layout(anim)
	local v = viewport()
	local s = math.clamp(v.Y / 470, 0.72, 1)
	local h = cfg.min and HMIN or H
	U.sc.Scale = s
	U.bMin.Text = cfg.min and "+" or "-"
	U.layTok = (U.layTok or 0) + 1
	local tok = U.layTok
	if anim then
		if not cfg.min then
			U.body.Visible = true
			U.div.Visible = true
		end
		tw(U.inner, { Size = UDim2.fromOffset(W, h) }, 0.35)
		tw(U.root, { Size = UDim2.fromOffset(W * s, h * s) }, 0.35)
		task.delay(0.38, function()
			if tok ~= U.layTok then return end
			U.body.Visible = not cfg.min
			U.div.Visible = not cfg.min
			clampRoot(s)
		end)
	else
		U.inner.Size = UDim2.fromOffset(W, h)
		U.root.Size = UDim2.fromOffset(W * s, h * s)
		U.body.Visible = not cfg.min
		U.div.Visible = not cfg.min
		clampRoot(s)
	end
end

local function setOpen(open, anim)
	U.openTok = (U.openTok or 0) + 1
	local tok = U.openTok
	if open then
		U.fb.Visible = false
		U.root.Visible = true
		layout(false)
		if anim then
			local s = U.sc.Scale
			U.sc.Scale = s * 0.85
			U.inner.BackgroundTransparency = 0.6
			tw(U.sc, { Scale = s }, 0.4, Enum.EasingStyle.Back)
			tw(U.inner, { BackgroundTransparency = 0 }, 0.3)
		end
	else
		U.fb.Visible = true
		U.fbSc.Scale = 0
		tw(U.fbSc, { Scale = 1 }, 0.45, Enum.EasingStyle.Back)
		if anim then
			local s = U.sc.Scale
			tw(U.sc, { Scale = s * 0.85 }, 0.2)
			tw(U.inner, { BackgroundTransparency = 0.6 }, 0.2)
			task.delay(0.22, function()
				if tok ~= U.openTok then return end
				U.root.Visible = false
				U.sc.Scale = s
				U.inner.BackgroundTransparency = 0
			end)
		else
			U.root.Visible = false
		end
	end
end

-- ZIEHEN (Fenster + Floating Button)
local function makeDrag(handle, target, onTap, onSave)
	local dIn, dStart, dBase = nil, nil, nil
	local moved = false
	on(handle.InputBegan, function(i)
		if isPress(i) then
			dIn = i
			dStart = i.Position
			dBase = target.Position
			moved = false
		end
	end)
	on(UIS.InputChanged, function(i)
		if not dIn then return end
		if dIn.UserInputState == Enum.UserInputState.End or dIn.UserInputState == Enum.UserInputState.Cancel then
			dIn = nil
			return
		end
		local ok = (i == dIn) or (i.UserInputType == Enum.UserInputType.MouseMovement and dIn.UserInputType == Enum.UserInputType.MouseButton1)
		if not ok then return end
		local d = i.Position - dStart
		if not moved and d.Magnitude < 8 then return end
		moved = true
		local v = viewport()
		local sz = target.AbsoluteSize
		target.Position = UDim2.fromOffset(
			math.clamp(dBase.X.Offset + d.X, -sz.X + 70, v.X - 70),
			math.clamp(dBase.Y.Offset + d.Y, 0, v.Y - 40)
		)
	end)
	on(UIS.InputEnded, function(i)
		if dIn and (i == dIn or i.UserInputType == dIn.UserInputType) then
			local wasMoved = moved
			dIn = nil
			if wasMoved then
				if onSave then onSave() end
			elseif onTap then
				onTap()
			end
		end
	end)
end

