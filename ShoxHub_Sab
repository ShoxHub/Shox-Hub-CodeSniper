local FONT_FAMILY = "rbxasset://fonts/families/Montserrat.json"
local FH = Font.new(FONT_FAMILY, Enum.FontWeight.Heavy)
local FX = Font.new(FONT_FAMILY, Enum.FontWeight.ExtraBold)
local FM = Font.new(FONT_FAMILY, Enum.FontWeight.Medium)

local function new(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function stroke(p, th, col, border, tr)
    return new("UIStroke", {Thickness = th, Color = col, Transparency = tr or 0,
        ApplyStrokeMode = border and Enum.ApplyStrokeMode.Border or Enum.ApplyStrokeMode.Contextual}, p)
end

local function makeBtn(parent, x, y, w, h, r, fillColor, text, size)
    local btn = new("TextButton", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(0, 0, 0),
        Position = UDim2.new(0, x, 0, y), Size = UDim2.new(0, w, 0, h), AutoButtonColor = false, Text = ""}, parent)
    corner(btn, r)
    local fill = new("Frame", {BackgroundColor3 = fillColor, BorderSizePixel = 0,
        Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2)}, btn)
    corner(fill, r - 1)
    local lbl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), FontFace = FH,
        Text = text, TextColor3 = C.TEXT, TextSize = size}, btn)
    stroke(lbl, 2, C.STROKE_DARK)
    return btn, fill, lbl
end

local function makeRow(parent, y, text, size)
    local row = new("Frame", {BackgroundColor3 = C.BG_ROW, BorderSizePixel = 0,
        Position = UDim2.new(0, 10, 0, y), Size = UDim2.new(1, -20, 0, 68)}, parent)
    corner(row, 12)
    stroke(row, 1.5, C.STROKE_DARK, true, 0.3)
    local lbl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), FontFace = FH,
        Text = text, TextColor3 = C.TEXT, TextSize = size or 26, TextXAlignment = Enum.TextXAlignment.Left}, row)
    stroke(lbl, 2, C.STROKE_DARK)
    new("UIPadding", {PaddingLeft = UDim.new(0, 16)}, lbl)
    return row, lbl
end

local function makeToggleButton(parent, x, text)
    return makeBtn(parent, x, 34, 100, 46, 10, C.INACTIVE, text, 24)
end

-- onChange may return false -> toggle stays as it is.
-- Returns a setter(state) that only re-renders (no onChange call).
local function makeToggle(btn, fill, lbl, initial, onChange)
    local state = initial and true or false
    local function render()
        fill.BackgroundColor3 = state and C.ON or C.OFF
        lbl.TextColor3 = state and C.TEXT_ON or C.TEXT
        lbl.Text = state and "ON" or "OFF"
    end
    render()
    btn.MouseButton1Click:Connect(function()
        local nextState = not state
        if onChange then
            local ok, res = pcall(onChange, nextState)
            if ok and res == false then return end
        end
        state = nextState
        render()
    end)
    return function(v) state = v and true or false; render() end
end

