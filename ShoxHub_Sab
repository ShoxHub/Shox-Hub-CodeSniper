-- THEMES
local function updateTexts()
	U.bTheme.Text = "Theme: " .. cfg.theme
	U.bIntro.Text = "Intro: " .. INTRO_NAMES[cfg.intro]
end

local function applyTheme(name, quick)
	if not THEMES[name] then return end
	T = THEMES[name]
	cfg.theme = name
	for _, e in ipairs(themed) do
		if quick then
			pcall(function()
				e[1][e[2]] = T[e[3]]
			end)
		else
			tw(e[1], { [e[2]] = T[e[3]] }, 0.3)
		end
	end
	for _, f in ipairs(refreshers) do
		pcall(f, false)
	end
	updateTexts()
	if not quick then save() end
end

