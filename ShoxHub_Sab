local function submitCapturedCode(code, partsList)
    if not code or code == "" then return end
    if S.seen[code] or S.submitting then return end
    S.seen[code] = true
    task.delay(2, function() S.seen[code] = nil end)
    S.lastCode = code
    S.stamp = os.clock()
    local stamp = S.stamp

    -- Auto Type OFF: only show the code, user presses USE in the Feed
    if not S.autoTypeOn then
        playPing()
        setRunning(false)
        UI.codeLabel.Text = code
        setStatus("caught: " .. code, "ok")
        feedAdd("Code caught (Auto Type off)", code)
        task.delay(3, function()
            if S.stamp == stamp then UI.codeLabel.Text = "Code Will Show Here" end
        end)
        return
    end

    S.submitting = true
    local ok, why = submitCodeAdvanced(code)
    S.submitting = false

    -- confirm retries (game sometimes eats the first click)
    -- only re-send if the game has not answered yet (any notification = answered); avoids "unexpected error" from double redeems
    if ok then
        local sentAt = os.clock()
        task.spawn(function()
            for _ = 1, 2 do
                task.wait(0.15)
                if S.dead or S.lastNotifAt > sentAt then return end
                submitCodeAdvanced(code)
            end
        end)
    end

    -- all UI / sound work AFTER the submit, never blocks it
    task.defer(function()
        playPing()
        setRunning(false)
        if ok then setStatus("sent: " .. code, "ok") else setStatus("failed (" .. tostring(why) .. "): " .. code, "err") end
        feedAdd(ok and "Code sent" or ("Code failed: " .. tostring(why)), code)

        task.delay(3, function()
            if S.stamp == stamp then UI.codeLabel.Text = "Code Will Show Here" end
        end)
    end)
end

local function captureWord(word)
    if not word or word == "" or not S.running then return end

    -- SPAM MODE: ignores the word count. Every new word -> redeem everything collected so far, 3x fast.
    if S.spamMode then
        S.parts[#S.parts + 1] = word
        local joined = table.concat(S.parts)
        local n = #S.parts
        S.lastCode = joined
        S.spamTok = (S.spamTok or 0) + 1
        local tok = S.spamTok
        if S.autoTypeOn then
            local box = fast and fast.box or getBox()
            if box then pcall(function() box.Text = joined end) end
            task.spawn(function()
                for i = 1, 3 do
                    if S.dead then return end
                    submitCodeAdvanced(joined)
                    if i < 3 then task.wait(0.04) end
                end
            end)
        end
        task.defer(function()
            if n == 1 then playPing() end
            UI.progress.Text = n .. " words"
            UI.codeLabel.Text = joined
            setStatus((S.autoTypeOn and "spam: " or "caught: ") .. joined, "ok")
            feedAdd(S.autoTypeOn and "Spam redeem x3" or "Spam Mode (Auto Type off)", joined)
        end)
        -- session ends 4.5s after the last word (or at 12 words)
        task.delay(4.5, function()
            if S.spamTok == tok and S.running then setRunning(false) end
        end)
        if n >= 12 then task.defer(function() if S.running then setRunning(false) end end) end
        return
    end
    S.parts[#S.parts + 1] = word
    if #S.parts >= getWordCount() then
        local list = S.parts
        local code = table.concat(list)
        S.parts = {}
        submitCapturedCode(code, list)
        return
    end
    local joined = table.concat(S.parts)
    if S.autoTypeOn then
        local box = fast and fast.box or getBox()
        if box then pcall(function() box.Text = joined end) end
    end
    local n = #S.parts
    task.defer(function()
        UI.progress.Text = n .. "/" .. getWordCount()
        UI.codeLabel.Text = joined
    end)
end

local function detectTrigger(text)
    local lower = text:lower()
    for _, trig in ipairs({"use code", "code is", "code:", "use:", "redeem code"}) do
        local _, e = lower:find(trig, 1, true)
        if e then return true, text:sub(e + 1) end
    end
    return false, text
end

