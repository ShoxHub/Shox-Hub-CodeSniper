	CS.Settings.UseNotify = not CS.Settings.UseNotify
	CS.setToggle(U.notify, "Notify", CS.Settings.UseNotify)
	CS.save()
end)
CS.on(U.submitManual.MouseButton1Click, function()
	local code = (CS.clean(U.manual.Text):gsub("%s+", ""))
	if code == "" then CS.log("Type a code first") return end
	CS.submit(code, "manual", true)
end)
CS.on(U.submitLast.MouseButton1Click, function()
	if not CS.LastCode then CS.log("No code yet") return end
	CS.submit(CS.LastCode, "last", true)
end)
CS.on(U.trans.MouseButton1Click, function()
	CS.Settings.Trans = CS.Settings.Trans % #CS.Trans + 1
	CS.refresh()
	CS.save()
end)
CS.on(U.size.MouseButton1Click, function()
	CS.Settings.Scale = CS.Settings.Scale % #CS.Scales + 1
	CS.tw(U.scale, { Scale = CS.Scales[CS.Settings.Scale] }, 0.4, Enum.EasingStyle.Back)
	CS.refresh()
	CS.save()
end)
CS.on(U.theme.MouseButton1Click, function() CS.setDD(not CS.ddOpen) end)
CS.on(U.intro.MouseButton1Click, function()
	CS.Settings.Intro = not CS.Settings.Intro
	CS.refresh()
	CS.save()
	if CS.Settings.Intro then
		task.spawn(function()
			pcall(function()
				CS.ensureIntro()
				CS.playIntro()
			end)
		end)
	else
		CS.stopIntro()
	end
end)
CS.on(U.discord.MouseButton1Click, function()
	local ok = pcall(function() setclipboard(CS.Discord) end)
	CS.log(ok and "Discord link copied" or "Copy not possible: " .. CS.Discord)
end)
CS.on(U.minBtn.MouseButton1Click, function() CS.setOpen(false) end)
CS.on(U.closeBtn.MouseButton1Click, CS.stop)
CS.on(U.quit.MouseButton1Click, CS.stop)

CS.on(S.RS.Heartbeat, function(dt)
	if not CS.Running then return end
	U.grad.Rotation = (U.grad.Rotation + dt * (CS.Settings.Sniper and 90 or 40)) % 360
	local pulse = (math.sin(os.clock() * 4) + 1) / 2
	U.dot.BackgroundTransparency = CS.Settings.Sniper and (0.5 * (1 - pulse)) or 0.4
	CS.Tick = CS.Tick + dt
	if CS.Tick >= 0.5 then
		CS.Tick = 0
		CS.TickN = CS.TickN + 1
		if CS.Settings.Sniper and CS.TickN % 4 == 0 then pcall(CS.prime) end
		CS.updateStatus()
	end
end)

CS.refresh()
CS.log("Shox Hub Code Sniper " .. CS.Version .. " loaded")
CS.log("Safe Mode: " .. (CS.Settings.SafeMode and "ON (types, no send)" or "OFF (types + sends)"))
CS.setOpen(true)
task.spawn(function() pcall(CS.hookGui) end)

-- Remote scan runs after the intro so it cannot cause lag during it
task.spawn(function()
	local started = os.clock()
	while CS.Running and (not CS.IntroDone or CS.introG) and os.clock() - started < 15 do task.wait(0.1) end
	if CS.Running then CS.discover() end
end)
