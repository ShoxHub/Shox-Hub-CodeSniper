local CONFIG_FILE = "Shox_cfg.txt"
local config = {}
local function loadConfig()
    config = {}
    if readfile and isfile then
        local ok, txt = pcall(function() if isfile(CONFIG_FILE) then return readfile(CONFIG_FILE) end end)
        if ok and type(txt) == "string" then
            for line in txt:gmatch("[^\n]+") do
                local k, v = line:match("^(%w+)=(.*)$")
                if k then config[k] = v end
            end
        end
    end
end
local function saveConfig()
    if writefile then
        local lines = {}
        for k, v in pairs(config) do lines[#lines + 1] = tostring(k) .. "=" .. tostring(v) end
        table.sort(lines)
        pcall(writefile, CONFIG_FILE, table.concat(lines, "\n"))
    end
end
local function cfgBool(key, def)
    local v = config[key]
    if v == "1" then return true end
    if v == "0" then return false end
    return def
end
local function cfgNum(key, def) return tonumber(config[key]) or def end
local function cfgSet(key, val)
    if type(val) == "boolean" then config[key] = val and "1" or "0" else config[key] = tostring(val) end
end
loadConfig()

