pcall(function()
	if isfile and readfile and isfile(FILE) then
		local d = HS:JSONDecode(readfile(FILE))
		if type(d) == "table" then
			if THEMES[d.theme] then cfg.theme = d.theme end
			if type(d.safe) == "boolean" then cfg.safe = d.safe end
			if type(d.sniper) == "boolean" then cfg.sniper = d.sniper end
			if d.intro == 0 or d.intro == 1 or d.intro == 2 then cfg.intro = d.intro end
			if type(d.min) == "boolean" then cfg.min = d.min end
			if type(d.pos) == "table" and tonumber(d.pos[1]) and tonumber(d.pos[2]) then
				cfg.pos = { tonumber(d.pos[1]), tonumber(d.pos[2]) }
			end
