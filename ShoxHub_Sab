-- [25] FPS BOOST (from Aetherion, simplified)
-- =========================================================================
local fpsRecords = {}
local function applyFPSBoost(obj)
    if not _fpsEnabled then return end
    pcall(function()
        if obj:IsA("BasePart") then
            if obj.Material ~= Enum.Material.SmoothPlastic then obj.Material = Enum.Material.SmoothPlastic end
            obj.CastShadow = false
            obj.Reflectance = 0
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            obj.Enabled = false
        elseif obj:IsA("Light") or obj:IsA("PostEffect") or obj:IsA("Highlight") then
            obj.Enabled = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
            obj.Enabled = false
        end
    end)
end
local fpsDescConn
local function enableFPSBoost()
    _fpsEnabled = true
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)
    for _, obj in ipairs(Workspace:GetDescendants()) do applyFPSBoost(obj) end
    for _, obj in ipairs(Lighting:GetDescendants()) do applyFPSBoost(obj) end
    if fpsDescConn then fpsDescConn:Disconnect() end
    fpsDescConn = Workspace.DescendantAdded:Connect(function(obj) if _fpsEnabled then applyFPSBoost(obj) end end)
end
local function disableFPSBoost()
    _fpsEnabled = false
    if fpsDescConn then fpsDescConn:Disconnect(); fpsDescConn = nil end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
end

