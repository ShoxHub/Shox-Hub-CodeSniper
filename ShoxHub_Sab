    -- fake announcement: purely visual + fed to the sniper, nothing leaves your client
    local function fakeAnnounce(text)
        if type(text) ~= "string" or text == "" then return end
        showAnnouncement(text)
        S.lastNotifAt = os.clock()
        pcall(processText, text)
    end

    local function splitCode(code)
        local words = {}
        if code:find("%s") then
            for w in code:gmatch("%S+") do words[#words + 1] = w end
            return words
        end
        local cur = ""
        for ch in code:gmatch(".") do
            local newWord = ch:match("%u") or (ch:match("%d") and cur:match("%a$"))
            if newWord and cur ~= "" then words[#words + 1] = cur; cur = "" end
            cur = cur .. ch
        end
        if cur ~= "" then words[#words + 1] = cur end
        return words
    end

    local function announceCode(code)
        code = (code or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if code == "" then toast("Type a code first"); return end
        local words = splitCode(code)
        pending = selected and {code = norm(code), name = selected} or nil
        if pending then toast("Redeem " .. code .. " to spawn " .. selected) end
        task.spawn(function()
            fakeAnnounce("use code")
            for _, w in ipairs(words) do
                task.wait(0.3)
                if S.dead then return end
                fakeAnnounce(w)
            end
        end)
    end

    -- fake brainrot spawn: clone the model locally and put it in front of you
    local function findModel(name)
        local key = norm(name)
        for _, root in ipairs({ReplicatedStorage, workspace}) do
            local idx = modelIdx[root]
            if not idx then
                idx = {}
                local n = 0
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("Model") then
                        local k = norm(d.Name)
                        if not idx[k] then idx[k] = d end
                    end
                    n = n + 1
                    if n % 2000 == 0 then task.wait() end
                end
                modelIdx[root] = idx
            end
            local m = idx[key]
            if m and m.Parent then return m end
        end
        return nil
    end

    local function spawnBrainrot(name)
        if not name then toast("Select a brainrot first"); return end
        local ch = player.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local src = findModel(name)
        if not src then toast("No model found for " .. name); return end
        local ok = pcall(function()
            local c = src:Clone()
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("LuaSourceContainer") or d:IsA("ProximityPrompt") then
                    d:Destroy()
                elseif d:IsA("BasePart") then
                    d.Anchored = true; d.CanCollide = false
                end
            end
            c:PivotTo(hrp.CFrame * CFrame.new(0, 2, -7))
            c.Parent = workspace
            spawned[#spawned + 1] = c
        end)
        if not ok then toast("Spawn failed for " .. name) end
    end

