	CS.introS, CS.introG = nil, nil
end

-- Code Sniper core
CS.clean = function(text)
	text = tostring(text):gsub("<[^>]->", "")
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	return (text)
end

CS.strip = function(text)
	text = text:gsub("^[%.,!%?:;\"'%(%)%[%]%-]+", "")
	text = text:gsub("[%.,!%?:;\"'%(%)%[%]%-]+$", "")
	return text
end

-- Collects every short string from remote arguments (plain strings and tables)
CS.collect = function(...)
	local out, seen = {}, {}
	local function add(value)
		if type(value) ~= "string" then return end
		local text = CS.clean(value)
		if #text > 0 and #text <= 100 and not seen[text] then
			seen[text] = true
			out[#out + 1] = text
		end
	end
	local args = table.pack(...)
	for i = 1, args.n do
		local value = args[i]
		if type(value) == "string" then
			add(value)
		elseif type(value) == "table" then
			for _, key in ipairs({ "Text", "text", "Message", "message", "Content", "content" }) do
				add(rawget(value, key))
			end
			for _, inner in pairs(value) do add(inner) end
		end
	end
	return out
end

-- Trigger phrases: "use code" / "code is" in any case and with any punctuation.
-- Returns the text after the trigger (may be ""), or nil when there is no trigger.
CS.trigger = function(text)
	local flat = (text:gsub("[^%w]", " ")):lower()
	for _, pat in ipairs(CS.Triggers) do
		local _, e = flat:find(pat)
		if e then return text:sub(e + 1) end
	end
	return nil
end

CS.findBox = function()
	local pg = S.Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end
	if CS.Box and CS.Box.Parent and CS.Box:IsDescendantOf(pg) then return CS.Box end
	local g1 = pg:FindFirstChild("Codes")
	local g2 = g1 and g1:FindFirstChild("Codes")
	local g3 = g2 and g2:FindFirstChild("CodeRedeem")
	local box = g3 and g3:FindFirstChild("TextBox")
	if not (box and box:IsA("TextBox")) then
		box = nil
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("TextBox") then
				local path = d:GetFullName():lower()
				local hint = (d.PlaceholderText or ""):lower()
				if path:find("code", 1, true) or hint:find("code", 1, true) then
					box = d
					break
				end
			end
		end
	end
	CS.Box = box
	CS.Btn = nil
	return box
end

CS.findSubmit = function(box)
	local scope = box.Parent
	for _ = 1, 3 do
		if not scope or scope:IsA("PlayerGui") or scope == game then break end
		for _, d in ipairs(scope:GetDescendants()) do
			if d:IsA("GuiButton") then
				local name = d.Name:lower()
				local label = d:IsA("TextButton") and d.Text:lower() or ""
				if name:find("submit", 1, true) or name:find("redeem", 1, true) or label:find("submit", 1, true) or label:find("redeem", 1, true) then
					return d
				end
			end
		end
		scope = scope.Parent
	end
end

-- Keeps the code box and submit button cached so a submit needs no searching
CS.prime = function()
	local box = CS.findBox()
	if box and not (CS.Btn and CS.Btn.Parent) then
		CS.Btn = CS.findSubmit(box)
	end
end

CS.press = function(btn)
	local names = { "Activated", "MouseButton1Click", "MouseButton1Down" }
	if getconnections then
		for _, name in ipairs(names) do
			local okC, conns = pcall(getconnections, btn[name])
			if okC and type(conns) == "table" and #conns > 0 then
				local fired = false
				for _, conn in ipairs(conns) do
					if pcall(function() conn:Fire() end) then fired = true end
				end
				if fired then return true end
			end
		end
	end
	if firesignal then
		for _, name in ipairs(names) do
			if pcall(firesignal, btn[name]) then return true end
		end
	end
	return false
end

CS.redeem = function(code, submit)
	local box = CS.findBox()
	if not box then return false, "code TextBox not found" end
	box.Text = code
	if not submit then return true, "typed" end
	local btn = CS.Btn
	if not (btn and btn.Parent) then
		btn = CS.findSubmit(box)
		CS.Btn = btn
	end
	if btn and CS.press(btn) then return true, "button " .. btn.Name end
	if getconnections then
		local okC, conns = pcall(getconnections, box.FocusLost)
		if okC and type(conns) == "table" and #conns > 0 then
			for _, conn in ipairs(conns) do pcall(function() conn:Fire(true) end) end
			return true, "FocusLost"
		end
	end
	if firesignal and pcall(firesignal, box.FocusLost, true) then return true, "FocusLost" end
	return false, "could not trigger submit"
end

-- Runs instantly in the same frame (no task.spawn, no wait)
CS.submit = function(code, source, force)
	local now = os.clock()
	if not force and CS.Recent[code] and now - CS.Recent[code] < 30 then return end
	CS.Recent[code] = now
	CS.LastCode = code
	local live = force or not CS.Settings.SafeMode
	local okR, ok, how = pcall(CS.redeem, code, live)
	if not okR then
		ok, how = false, ok
	end
	CS.log("Code: " .. code .. " (" .. source .. ")")
	if not ok then
		CS.log("Failed: " .. tostring(how))
	elseif live then
		CS.log("Submitted via " .. how)
	else
		CS.log("SAFE: typed in box, NOT sent. Press Submit Last")
	end
	CS.updateStatus()
end

CS.deliver = function(code)
	if CS.Settings.AutoSubmit then
		CS.submit(code, "announcement", false)
	else
		CS.LastCode = code
		CS.log("Code ready: " .. code .. " (Auto Submit OFF)")
	end
	CS.updateStatus()
end

CS.arm = function(src)
	CS.Armed = os.clock()
	CS.Buffer = {}
	CS.log("Trigger (" .. src .. "): collecting")
	CS.updateStatus()
end

-- A single word/piece. Only counts while armed by a trigger.
CS.onPiece = function(text, src)
	if not CS.armed() then return end
	text = CS.strip(text)
	if text == "" then return end
	if text:find("%s") then
		CS.log("Ignored: " .. text)
		return
	end
	CS.Armed = os.clock()
	table.insert(CS.Buffer, text)
	CS.log("Word " .. #CS.Buffer .. "/" .. CS.Settings.Parts .. ": " .. text .. " (" .. tostring(src) .. ")")
	if #CS.Buffer >= CS.Settings.Parts then
		local code = table.concat(CS.Buffer)
		CS.Buffer = {}
		CS.Armed = nil
		CS.deliver(code)
		return
	end
	CS.updateStatus()
end

-- Every detected text (remote or GUI) goes through here
CS.onText = function(text, src)
	if not CS.Settings.Sniper or not CS.Settings.UseNotify then return end
	text = CS.clean(text)
	if text == "" then return end
	local now = os.clock()
	if now - CS.SeenT > 60 then
		CS.Seen = {}
		CS.SeenT = now
	end
	if CS.Seen[text] and now - CS.Seen[text] < 1.25 then return end
	CS.Seen[text] = now
	local rest = CS.trigger(text)
	if rest == nil then
		CS.onPiece(text, src)
		return
	end
	CS.arm(src)
	local tokens = {}
	for tok in rest:gmatch("%S+") do
		local word = CS.strip(tok)
		if word ~= "" then tokens[#tokens + 1] = word end
	end
	if #tokens > 0 then
		CS.Armed = nil
		CS.Buffer = {}
		CS.deliver(table.concat(tokens))
	end
end

CS.hookRemote = function(remote)
	if CS.Hooked[remote] then return end
	CS.Hooked[remote] = true
	CS.Found = CS.Found + 1
	CS.on(remote.OnClientEvent, function(...)
		if not CS.Settings.Sniper then return end
		local ok, list = pcall(CS.collect, ...)
		if not ok then return end
		local hit = false
		for _, text in ipairs(list) do
			if CS.trigger(text) ~= nil then
				hit = true
				CS.onText(text, "remote")
			end
		end
		if not hit and list[1] then CS.onText(list[1], "remote") end
	end)
	CS.log("Hooked remote: " .. remote.Name)
	CS.updateStatus()
end

CS.scanNotify = function()
	local getups = getupvalues or (debug and debug.getupvalues)
	pcall(function()
		local ctrl = S.Rep:FindFirstChild("Controllers")
		ctrl = ctrl and ctrl:FindFirstChild("NotificationController")
		if ctrl and ctrl:IsA("ModuleScript") and getups then
			local mod = require(ctrl)
			if type(mod) == "table" then
				for _, fn in pairs(mod) do
					if type(fn) == "function" then
						local okU, ups = pcall(getups, fn)
						if okU and type(ups) == "table" then
							for _, up in pairs(ups) do
								if typeof(up) == "Instance" and up:IsA("RemoteEvent") then
									CS.hookRemote(up)
								elseif type(up) == "table" then
									for _, inner in pairs(up) do
										if typeof(inner) == "Instance" and inner:IsA("RemoteEvent") then CS.hookRemote(inner) end
									end
								end
							end
						end
					end
				end
			end
		end
	end)
	pcall(function()
		local packages = S.Rep:FindFirstChild("Packages")
		local net = packages and packages:FindFirstChild("Net")
		if not (net and getconnections) then return end
		for _, remote in ipairs(net:GetDescendants()) do
			if remote:IsA("RemoteEvent") then
				local okC, conns = pcall(getconnections, remote.OnClientEvent)
				if okC and type(conns) == "table" then
					for _, conn in ipairs(conns) do
						local okF, fn = pcall(function() return conn.Function end)
						if okF and type(fn) == "function" then
							local matched = false
							local okS, src = pcall(function() return debug.getinfo(fn, "s").source end)
							if okS and type(src) == "string" and src:find("NotificationController", 1, true) then matched = true end
							if not matched then
								local okE, fenv = pcall(getfenv, fn)
								if okE and type(fenv) == "table" then
									local scr = rawget(fenv, "script")
									matched = typeof(scr) == "Instance" and scr.Name == "NotificationController"
								end
							end
							if matched then
								CS.hookRemote(remote)
								break
							end
						end
					end
				end
			end
		end
	end)
	pcall(function()
		if CS.Found > 0 then return end
		for _, remote in ipairs(S.Rep:GetDescendants()) do
			if remote:IsA("RemoteEvent") and remote.Name:lower():find("notif", 1, true) then CS.hookRemote(remote) end
		end
	end)
end

CS.discover = function()
	if CS.Discovering or CS.Found > 0 then return end
	CS.Discovering = true
	task.spawn(function()
		for _ = 1, 6 do
			if not CS.Running then break end
			CS.scanNotify()
			if CS.Found > 0 then break end
			task.wait(2)
		end
		CS.Discovering = false
		if CS.Found == 0 then CS.log("No notification remote found (GUI watcher still active)") end
		CS.updateStatus()
	end)
end

-- Second detection path: watches new text labels that appear in the game UI.
-- Waits until the text stops changing so typewriter-style notifications are read complete.
CS.hookGui = function()
	local pg = S.Players.LocalPlayer:FindFirstChild("PlayerGui") or S.Players.LocalPlayer:WaitForChild("PlayerGui", 10)
	if not pg then return end
	CS.on(pg.DescendantAdded, function(d)
		if not CS.Settings.Sniper or not d:IsA("TextLabel") then return end
		if U.gui and d:IsDescendantOf(U.gui) then return end
		if CS.introG and d:IsDescendantOf(CS.introG) then return end
		if d:GetFullName():lower():find("prompt", 1, true) then return end
		local ver = 0
		local function check()
			ver = ver + 1
			local mine = ver
			task.delay(0.15, function()
				if CS.Running and mine == ver and d.Text ~= "" then CS.onText(d.Text, "gui") end
			end)
		end
		check()
		local conn = d:GetPropertyChangedSignal("Text"):Connect(check)
		task.delay(3, function() conn:Disconnect() end)
	end)
end

CS.stop = function()
	if not CS.Running then return end
	CS.Running = false
	pcall(CS.save)
	CS.stopIntro()
	for _, conn in ipairs(CS.Conn) do pcall(function() conn:Disconnect() end) end
	pcall(function() U.gui:Destroy() end)
	env.CodeSniperStop = nil
end

