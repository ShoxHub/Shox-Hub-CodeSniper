local function colBtn(parent, i, n, text)
	local g = 6
	local b = mk("TextButton", {
		Text = text,
		Position = UDim2.new((i - 1) / n, (i - 1) * g / n, 0, 0),
		Size = UDim2.new(1 / n, -(n - 1) * g / n, 1, 0),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextScaled = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, parent)
	corner(b, 9)
	mk("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 8 }, b)
	mk("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, b)
	reg(b, "BackgroundColor3", "btn")
	reg(b, "TextColor3", "txt")
	local sk = mk("UIStroke", { Thickness = 1, Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	reg(sk, "Color", "acc")
	local sc = mk("UIScale", { Scale = 1 }, b)
	on(b.InputBegan, function(x)
		if isPress(x) then tw(sc, { Scale = 0.94 }, 0.08) end
	end)
	on(b.InputEnded, function(x)
		if isPress(x) then tw(sc, { Scale = 1 }, 0.25, Enum.EasingStyle.Back) end
	end)
	return b
end

local function addToggle(text, key, onChange)
	local r = mkRow(30)
	r.BackgroundTransparency = 0
	r.BorderSizePixel = 0
	corner(r, 9)
	reg(r, "BackgroundColor3", "btn")
	local l = mk("TextLabel", {
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -60, 1, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, r)
	reg(l, "TextColor3", "txt")
	local pill = mk("TextButton", {
		Position = UDim2.new(1, -46, 0.5, -10),
		Size = UDim2.fromOffset(38, 20),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, r)
	corner(pill, 10)
	local dot = mk("Frame", {
		Size = UDim2.fromOffset(14, 14),
		BorderSizePixel = 0,
	}, pill)
	corner(dot, 7)
	local function refresh(anim)
		local isOn = cfg[key]
		local pos = isOn and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
		local col = isOn and T.acc or T.line
		if anim then
			tw(pill, { BackgroundColor3 = col }, 0.15)
			tw(dot, { Position = pos, BackgroundColor3 = T.bg }, 0.15)
		else
			pill.BackgroundColor3 = col
			dot.Position = pos
			dot.BackgroundColor3 = T.bg
		end
	end
	refreshers[#refreshers + 1] = refresh
	refresh(false)
	on(pill.MouseButton1Click, function()
		cfg[key] = not cfg[key]
		refresh(true)
		updateStatus()
		save()
		onChange(cfg[key])
	end)
	return r
end

