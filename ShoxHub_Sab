-- AUTO BUY: fires the purchase prompt of every brainrot within range (10-20 studs)
S.buyRange = math.clamp(math.floor(cfgNum("buyRange", 15)), 10, 20)
do
    local firePrompt_ = fireproximityprompt
    local BUY_WORDS = {"buy", "purchase", "kaufen"}
    local prompts = setmetatable({}, {__mode = "k"})
    local lastFire = setmetatable({}, {__mode = "k"})
    local logged = setmetatable({}, {__mode = "k"})
    local hb, addC, remC

    local function promptPos(p)
        local par = p.Parent
        if not par then return nil end
        if par:IsA("BasePart") then return par.Position end
        if par:IsA("Attachment") then return par.WorldPosition end
        local m = par:FindFirstAncestorOfClass("Model")
        if m then
            local ok, cf = pcall(m.GetPivot, m)
            if ok and cf then return cf.Position end
        end
        return nil
    end

    local function isBuyPrompt(p)
        local action = (p.ActionText or ""):lower()
        if action:find("steal", 1, true) then return false end
        return hasAny(action .. " " .. (p.ObjectText or ""):lower() .. " " .. p.Name:lower(), BUY_WORDS)
    end

    local function buyFire(p)
        pcall(function() p.HoldDuration = 0 end)
        pcall(function() p.RequiresLineOfSight = false end)
        if firePrompt_ then
            pcall(firePrompt_, p)
        else
            task.spawn(function()
                pcall(function() p:InputHoldBegin(); task.wait(0.05); p:InputHoldEnd() end)
            end)
        end
    end

    function UI.buyStop()
        S.autoBuy = false
        if hb then hb:Disconnect(); hb = nil end
        if addC then addC:Disconnect(); addC = nil end
        if remC then remC:Disconnect(); remC = nil end
    end

    function UI.buyStart()
        UI.buyStop()
        S.autoBuy = true
        task.spawn(function()
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") then prompts[d] = true end
            end
        end)
        addC = workspace.DescendantAdded:Connect(function(d)
            if d:IsA("ProximityPrompt") then prompts[d] = true end
        end)
        remC = workspace.DescendantRemoving:Connect(function(d) prompts[d] = nil end)
        hb = RunService.Heartbeat:Connect(function()
            if S.dead then return end
            local ch = player.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local hp, range, now = hrp.Position, S.buyRange, os.clock()
            for p in pairs(prompts) do
                if not p.Parent then
                    prompts[p] = nil
                elseif p.Enabled and (now - (lastFire[p] or 0)) > 0.2 then
                    local pos = promptPos(p)
                    if pos and (pos - hp).Magnitude <= range and not p:IsDescendantOf(ch) and isBuyPrompt(p) then
                        lastFire[p] = now
                        buyFire(p)
                    end
                end
            end
        end)
    end
end

-- FPS BOOST: lowest quality, no shadows/effects/particles, flat materials; restores everything on OFF
do
    local saved, partOrig, fxOrig, addC = {}, {}, {}, nil
    local FX_CLASSES = {ParticleEmitter = true, Trail = true, Beam = true, Smoke = true, Fire = true,
        Sparkles = true, Explosion = true, PointLight = true, SpotLight = true, SurfaceLight = true}
    local POST_CLASSES = {BloomEffect = true, BlurEffect = true, ColorCorrectionEffect = true,
        DepthOfFieldEffect = true, SunRaysEffect = true, Atmosphere = true}

    local function boost(d)
        if d:IsA("BasePart") then
            if partOrig[d] == nil and not d:IsA("Terrain") then
                partOrig[d] = {d.Material, d.Reflectance, d.CastShadow}
                d.Material = Enum.Material.SmoothPlastic
                d.Reflectance = 0
                d.CastShadow = false
            end
        elseif FX_CLASSES[d.ClassName] then
            if fxOrig[d] == nil then fxOrig[d] = d.Enabled; d.Enabled = false end
        end
    end

    function UI.fpsSet(v)
        S.fps = v
        pcall(function()
            if v then
                saved.quality = saved.quality or settings().Rendering.QualityLevel
                saved.shadows = Lighting.GlobalShadows
                saved.fogEnd = Lighting.FogEnd
                saved.bright = Lighting.Brightness
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 9e9
                saved.post = {}
                for _, e in ipairs(Lighting:GetChildren()) do
                    if POST_CLASSES[e.ClassName] then
                        saved.post[e] = e.Enabled ~= nil and e.Enabled or true
                        pcall(function() e.Enabled = false end)
                        if e:IsA("Atmosphere") then pcall(function() e.Density = 0 end) end
                    end
                end
                pcall(function()
                    local t = workspace.Terrain
                    saved.water = {t.WaterWaveSize, t.WaterReflectance, t.WaterTransparency}
                    t.WaterWaveSize = 0; t.WaterReflectance = 0; t.WaterTransparency = 1
                    t.Decoration = false
                end)
                if addC then addC:Disconnect() end
                addC = workspace.DescendantAdded:Connect(function(d) pcall(boost, d) end)
                task.spawn(function()
                    local n = 0
                    for _, d in ipairs(workspace:GetDescendants()) do
                        if not S.fps or S.dead then return end
                        pcall(boost, d)
                        n = n + 1
                        if n % 400 == 0 then task.wait() end
                    end
                end)
            else
                if addC then addC:Disconnect(); addC = nil end
                if saved.quality then settings().Rendering.QualityLevel = saved.quality end
                if saved.shadows ~= nil then Lighting.GlobalShadows = saved.shadows end
                if saved.fogEnd then Lighting.FogEnd = saved.fogEnd end
                for e, en in pairs(saved.post or {}) do pcall(function() e.Enabled = en end) end
                if saved.water then
                    pcall(function()
                        local t = workspace.Terrain
                        t.WaterWaveSize, t.WaterReflectance, t.WaterTransparency = table.unpack(saved.water)
                        t.Decoration = true
                    end)
                end
                for d, o in pairs(partOrig) do
                    pcall(function() d.Material, d.Reflectance, d.CastShadow = o[1], o[2], o[3] end)
                end
                for d, en in pairs(fxOrig) do pcall(function() d.Enabled = en end) end
                partOrig, fxOrig, saved = {}, {}, {}
            end
        end)
    end
end

