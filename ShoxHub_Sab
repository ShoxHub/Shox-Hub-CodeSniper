-- =========================================================================
-- [10] EVENT BLOCKER (Traced)
-- =========================================================================
local eventBlock = {ready = false, why = "EventController unavailable", IsBlocked = function() return false end}
do
    local function requireController(name)
        local folder = ReplicatedStorage:FindFirstChild("Controllers")
        folder = folder and folder:FindFirstChild(name, true)
        if not (folder and folder:IsA("ModuleScript")) then return nil end
        local ok, mod = pcall(require, folder)
        if ok and type(mod) == "table" then return mod end
    end
    local EventController  = requireController("EventController")
    local EffectController = requireController("EffectController")
    local valid = EventController and type(EventController.Events) == "table" and type(EventController.Execute) == "function"
    if not valid then eventBlock.why = "EventController missing"
    else
        local tool = _G.__BrainrotEventTool or {}; _G.__BrainrotEventTool = tool
        tool.origExecute   = tool.origExecute   or EventController.Execute
        tool.origGetActive = tool.origGetActive or EventController.GetActiveEvents
        if EffectController then tool.origRun = tool.origRun or EffectController.Run end
        tool.blocked = tool.blocked or false
        eventBlock.S = tool
        eventBlock.IsBlocked = function() return tool.blocked and true or false end
        local effectsTable
        local getupvalue_ = debug and debug.getupvalue
        if getupvalue_ then
            local ok, v = pcall(getupvalue_, tool.origExecute, 5)
            if ok and type(v) == "table" then effectsTable = v end
        end
        if not tool.shimmed then
            EventController.GetActiveEvents = function(self)
                local list = {}
                if not tool.blocked then
                    local ok, res = pcall(tool.origGetActive, self)
                    if ok and type(res) == "table" then for _, e in pairs(res) do list[#list + 1] = e end end
                end
                return list
            end
            tool.shimmed = true
        end
        local function refreshControllers()
            local lighting = requireController("LightingController")
            if lighting and type(lighting.Update) == "function" then pcall(function() lighting:Update() end) end
            local sound = requireController("SoundController")
            if sound and type(sound.UpdateOST) == "function" then pcall(function() sound:UpdateOST() end) end
        end
        local function isSkyEffect(inst)
            return inst:IsA("Sky") or inst:IsA("Atmosphere") or inst:IsA("Clouds") or inst:IsA("PostEffect")
        end
        local function stopAllEffects()
            if not (EffectController and type(EffectController.ActiveEffects) == "table") then return 0 end
            local keys = {}
            for k in pairs(EffectController.ActiveEffects) do keys[#keys + 1] = k end
            for _, k in ipairs(keys) do
                local def = type(EffectController.Effects) == "table" and EffectController.Effects[k] or nil
                EffectController.ActiveEffects[k] = nil
                if type(def) == "table" then
                    if type(def.OnUpdate) == "function" then pcall(function() def:OnUpdate() end) end
                    if type(def.OnStop) == "function" then pcall(function() def:OnStop() end) end
                end
            end
            return #keys
        end
        local function clearEventAttrs()
            local cleared = 0
            for k, v in pairs(ReplicatedStorage:GetAttributes()) do
                if type(k) == "string" and v == true and (k:find("Event") or k:find("Phase") or k:find("Hour")) then
                    pcall(function() ReplicatedStorage:SetAttribute(k, nil) end)
                    cleared = cleared + 1
                end
            end
            return cleared
        end
        local function stopLoopedSounds()
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("Sound") and d.Playing and d.Looped then pcall(function() d:Stop() end); n = n + 1 end
            end
            return n
        end
        eventBlock.Block = function()
            local cancelled = 0
            for k, ev in pairs(EventController.Events) do
                if type(ev) == "table" and rawget(ev, "Active") then
                    local ok = type(EventController.Cancel) == "function" and pcall(function() return EventController:Cancel(k) end)
                    if not ok then rawset(ev, "Active", false); rawset(ev, "__started", false) end
                    cancelled = cancelled + 1
                end
            end
            local effectsKilled = stopAllEffects()
            if effectsTable then
                for k, group in pairs(effectsTable) do
                    if type(group) == "table" then
                        for _, inst in ipairs(group) do
                            if typeof(inst) == "Instance" and not isSkyEffect(inst) then pcall(function() inst:Destroy() end) end
                        end
                    end
                    effectsTable[k] = nil
                end
            end
            EventController.Execute = function() return false end
            if EffectController then EffectController.Run = function() return false, false end end
            tool.blocked = true
            refreshControllers()
            clearEventAttrs()
            local sounds = stopLoopedSounds()
            return true, ("blocked %d event(s), %d fx, %d sound(s)"):format(cancelled, effectsKilled, sounds)
        end
        eventBlock.Unblock = function()
            EventController.Execute = tool.origExecute
            if EffectController and tool.origRun then EffectController.Run = tool.origRun end
            tool.blocked = false
            refreshControllers()
            return true, "unblocked"
        end
        eventBlock.ready = true
        eventBlock.why   = nil
    end
end

