	CS.introS, CS.introG = nil, nil
end

-- Code Sniper core
CS.clean = function(text)
	text = tostring(text):gsub("<[^>]->", "")
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	return (text)
end

CS.extractText = function(...)
	local args = table.pack(...)
	for i = 1, args.n do
		local value = args[i]
		if type(value) == "string" then
			local text = CS.clean(value)
			if #text > 0 and #text <= 40 then return text end
		elseif type(value) == "table" then
			for _, key in ipairs({ "Text", "text", "Message", "message", "Content", "content" }) do
				local inner = rawget(value, key)
				if type(inner) == "string" then
					local text = CS.clean(inner)
					if #text > 0 and #text <= 40 then return text end
				end
			end
			for _, inner in pairs(value) do
				if type(inner) == "string" then
					local text = CS.clean(inner)
					if #text > 0 and #text <= 40 then return text end
				end
			end
		end
	end
end

CS.redeem = function(code)
	local pg = S.Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return false, "PlayerGui missing" end
	local g1 = pg:FindFirstChild("Codes")
	local g2 = g1 and g1:FindFirstChild("Codes")
	local g3 = g2 and g2:FindFirstChild("CodeRedeem")
	local box = g3 and g3:FindFirstChild("TextBox")
	if not (box and box:IsA("TextBox")) then
		box = nil
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("TextBox") and d:GetFullName():lower():find("code", 1, true) and not d:IsDescendantOf(U.gui) then
				box = d
				break
			end
		end
	end
	if not box then return false, "code TextBox not found" end
	CS.log("TextBox: " .. box:GetFullName():gsub("^.-PlayerGui%.", ""))
	box.Text = code
	local fired = false
	if firesignal then
		if pcall(firesignal, box.FocusLost, true) then fired = true end
	elseif getconnections then
		local ok, conns = pcall(getconnections, box.FocusLost)
		if ok and type(conns) == "table" then
			for _, conn in ipairs(conns) do
				if pcall(function() conn:Fire(true) end) then fired = true end
			end
		end
	end
	task.wait(0.15)
	local scope = box.Parent or pg
	for _, d in ipairs(scope:GetDescendants()) do
		if d:IsA("GuiButton") then
			local name = d.Name:lower()
			local label = d:IsA("TextButton") and d.Text:lower() or ""
			if name:find("submit", 1, true) or name:find("redeem", 1, true) or name:find("enter", 1, true) or name:find("confirm", 1, true)
				or label:find("redeem", 1, true) or label:find("submit", 1, true) then
				if firesignal then
					pcall(firesignal, d.Activated)
					pcall(firesignal, d.MouseButton1Click)
					fired = true
				end
			end
		end
	end
	if not fired then return false, "could not trigger submit" end
	return true
end

CS.submit = function(code, source)
	local now = os.clock()
	if CS.Recent[code] and now - CS.Recent[code] < 30 then return end
	CS.Recent[code] = now
	CS.log("Code: " .. code .. " (" .. source .. ")")
	if CS.Settings.SafeMode then
		CS.log("[SAFE MODE ON] simulated only. Turn it OFF to redeem")
		return
	end
	local ok, why = CS.redeem(code)
	CS.log(ok and ("Redeem sent: " .. code) or ("Redeem failed: " .. tostring(why)))
end

CS.onPiece = function(text)
	if not CS.Settings.Sniper then return end
	if text:find("%s") then
		CS.log("Ignored: " .. text)
		return
	end
	local now = os.clock()
	if CS.LastPiece[text] and now - CS.LastPiece[text] < 1.25 then return end
	CS.LastPiece[text] = now
	if #CS.Buffer > 0 and now - CS.BufferT > CS.StaleAfter then
		CS.Buffer = {}
		CS.log("Old words cleared")
	end
	table.insert(CS.Buffer, text)
	CS.BufferT = now
	CS.log("Word " .. #CS.Buffer .. "/" .. CS.Settings.Parts .. ": " .. text)
	if #CS.Buffer >= CS.Settings.Parts then
		local code = table.concat(CS.Buffer)
		CS.Buffer = {}
		if CS.Settings.AutoSubmit then
			CS.submit(code, "announcement")
		else
			CS.log("Code ready: " .. code .. " (Auto Submit OFF)")
		end
	end
end

CS.onChat = function(text, userId)
	if not CS.Settings.Sniper then return end
	if userId and userId == S.Players.LocalPlayer.UserId then return end
	text = CS.clean(text)
	if text:match("^[A-Z0-9]+$") and #text >= 4 and #text <= 30 then
		CS.submit(text, "chat")
		return
	end
	local tagged = text:match("[Cc][Oo][Dd][Ee]%s*[:=%-]%s*([%w_]+)")
	if tagged and #tagged >= 3 then CS.submit(tagged, "chat") end
end

CS.hookRemote = function(remote)
	if CS.Hooked[remote] then return end
	CS.Hooked[remote] = true
	CS.Found = CS.Found + 1
	CS.on(remote.OnClientEvent, function(...)
		if not CS.Settings.Sniper then return end
		local text = CS.extractText(...)
		if text then CS.onPiece(text) end
	end)
	CS.log("Hooked remote: " .. remote.Name)
end

CS.scanNotify = function()
	local getups = getupvalues or (debug and debug.getupvalues)
	pcall(function()
		local ctrl = S.Rep:FindFirstChild("Controllers")
		ctrl = ctrl and ctrl:FindFirstChild("NotificationController")
		if ctrl and ctrl:IsA("ModuleScript") and getups then
			local mod = require(ctrl)
			if type(mod) == "table" then
				for _, fn in pairs(mod) do
					if type(fn) == "function" then
						local okU, ups = pcall(getups, fn)
						if okU and type(ups) == "table" then
							for _, up in pairs(ups) do
								if typeof(up) == "Instance" and up:IsA("RemoteEvent") then
									CS.hookRemote(up)
								elseif type(up) == "table" then
									for _, inner in pairs(up) do
										if typeof(inner) == "Instance" and inner:IsA("RemoteEvent") then CS.hookRemote(inner) end
									end
								end
							end
						end
					end
				end
			end
		end
	end)
	pcall(function()
		local packages = S.Rep:FindFirstChild("Packages")
		local net = packages and packages:FindFirstChild("Net")
		if not (net and getconnections) then return end
		for _, remote in ipairs(net:GetDescendants()) do
			if remote:IsA("RemoteEvent") then
				local okC, conns = pcall(getconnections, remote.OnClientEvent)
				if okC and type(conns) == "table" then
					for _, conn in ipairs(conns) do
						local okF, fn = pcall(function() return conn.Function end)
						if okF and type(fn) == "function" then
							local matched = false
							local okS, src = pcall(function() return debug.getinfo(fn, "s").source end)
							if okS and type(src) == "string" and src:find("NotificationController", 1, true) then matched = true end
							if not matched then
								local okE, fenv = pcall(getfenv, fn)
								if okE and type(fenv) == "table" then
									local scr = rawget(fenv, "script")
									matched = typeof(scr) == "Instance" and scr.Name == "NotificationController"
								end
							end
							if matched then
								CS.hookRemote(remote)
								break
							end
						end
					end
				end
			end
		end
	end)
	pcall(function()
		if CS.Found > 0 then return end
		for _, remote in ipairs(S.Rep:GetDescendants()) do
			if remote:IsA("RemoteEvent") and remote.Name:lower():find("notif", 1, true) then CS.hookRemote(remote) end
		end
	end)
end

CS.discover = function()
	if CS.Discovering or CS.Found > 0 then return end
	CS.Discovering = true
	task.spawn(function()
		for _ = 1, 6 do
			if not CS.Running then break end
			CS.scanNotify()
			if CS.Found > 0 then break end
			task.wait(2)
		end
		CS.Discovering = false
		if CS.Found == 0 then CS.log("No notification remote found") end
	end)
end

CS.hookChat = function()
	pcall(function()
		local function hookChannel(obj)
			if obj:IsA("TextChannel") and not CS.Hooked[obj] then
				CS.Hooked[obj] = true
				CS.on(obj.MessageReceived, function(msg)
					local userId = msg.TextSource and msg.TextSource.UserId
					CS.onChat(msg.Text, userId)
				end)
			end
		end
		for _, obj in ipairs(S.Chat:GetDescendants()) do hookChannel(obj) end
		CS.on(S.Chat.DescendantAdded, hookChannel)
	end)
	pcall(function()
		local function hookPlayer(player)
			if not CS.Hooked[player] then
				CS.Hooked[player] = true
				CS.on(player.Chatted, function(message) CS.onChat(message, player.UserId) end)
			end
		end
		for _, player in ipairs(S.Players:GetPlayers()) do hookPlayer(player) end
		CS.on(S.Players.PlayerAdded, hookPlayer)
	end)
end

CS.stop = function()
	if not CS.Running then return end
	CS.Running = false
	pcall(CS.save)
	CS.stopIntro()
	for _, conn in ipairs(CS.Conn) do pcall(function() conn:Disconnect() end) end
	pcall(function() U.gui:Destroy() end)
	env.CodeSniperStop = nil
end

