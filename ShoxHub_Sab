local SYS_COMPACT = {}
do
    local seen = {}
    for _, phrase in ipairs(SYS_PHRASES) do
        local c = compactStr(phrase)
        if c ~= "" and not seen[c] then
            seen[c] = true
            SYS_COMPACT[#SYS_COMPACT + 1] = { phrase = phrase, compact = c }
        end
    end
end
local function isSystemPhrase(text)
    if not ignoreSystem then return false end
    local lower = stripTags(tostring(text or "")):lower()
    local noSpaces = lower:gsub("%s+", "")
    for _, p in ipairs(SYS_PREFIXES) do
        if noSpaces:find(p, 1, true) then return true, p end
    end
    local c = compactStr(lower)
    for _, entry in ipairs(SYS_COMPACT) do
        if c:find(entry.compact, 1, true) then return true, entry.phrase end
    end
    return false
end

