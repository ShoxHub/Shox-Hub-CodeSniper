    else
        UI.startFill.BackgroundColor3 = C.OFF
        UI.startLbl.TextColor3 = C.TEXT
        UI.startLbl.Text = "OFF [F]"
        setStatus("Disabled", nil)
        S.parts = {}
        UI.progress.Text = "0/" .. getWordCount()
    end
end

local function submitCapturedCode(code)
    if not code or code == "" then return end
    if S.seen[code] or S.submitting then return end
    S.seen[code] = true
    task.delay(2, function() S.seen[code] = nil end)
    S.submitting = true
    S.lastCode = code
    S.stamp = os.clock()
    local stamp = S.stamp
    UI.codeLabel.Text = "Redeeming..."
    setStatus("redeeming: " .. code, "busy")
    local ok = submitCodeAdvanced(code)
    S.submitting = false
    setRunning(false)
    if ok then setStatus("sent: " .. code, "ok") else setStatus("failed: " .. code, "err") end
    feedAdd(ok and "Code sent" or "Code failed", code)
    task.delay(3, function()
        if S.stamp == stamp then UI.codeLabel.Text = "Code Will Show Here" end
    end)
end

local function captureWord(word)
    if not word or word == "" or not S.running then return end
    S.parts[#S.parts + 1] = word
    UI.progress.Text = #S.parts .. "/" .. getWordCount()
    UI.codeLabel.Text = table.concat(S.parts)
    if #S.parts >= getWordCount() then
        local code = table.concat(S.parts)
        S.parts = {}
        submitCapturedCode(code)
    end
end

local function detectTrigger(text)
    local lower = text:lower()
    for _, trig in ipairs({"use code", "code is", "code:", "use:", "redeem code"}) do
        local _, e = lower:find(trig, 1, true)
        if e then return true, text:sub(e + 1) end
    end
    return false, text
end

local function processText(text)
    local lower = text:lower()
    if lower:find("?", 1, true) or lower:find("riddle", 1, true) then
        feedAdd(text, nil)
        return
    end
    local triggered, remainder = detectTrigger(text)
    if triggered then
        if not S.running then
            if not S.autoOn then feedAdd(text, nil); return end
            setRunning(true)
        end
        S.parts = {}
        UI.codeLabel.Text = ""
        for word in remainder:gmatch("[%w_]+") do captureWord(word) end
    elseif S.running then
        for word in text:gmatch("[%w_]+") do captureWord(word) end
    else
        feedAdd(text, nil)
    end
end

task.spawn(function()
    local remote
    for _ = 1, 40 do
        remote = findNotificationRemote()
        if remote then break end
        task.wait(0.5)
    end
    if not remote then setStatus("Notification remote not found", "err"); return end
    local ok = pcall(function()
        remote.OnClientEvent:Connect(function(...)
            local text
            for _, a in ipairs({...}) do
                if type(a) == "string" then text = a; break end
            end
            if not text then return end
            text = stripTags(text):match("^%s*(.-)%s*$") or ""
            if text == "" then return end
            pcall(processText, text)
        end)
    end)
    if not ok then setStatus("Listener failed", "err") end
end)

