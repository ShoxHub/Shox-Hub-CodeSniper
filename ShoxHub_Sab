-- =========================================================================
local function setStatus(msg, kind)
    RedeemerStatusLabel.Text = "Redeemer: " .. tostring(msg or "")
    RedeemerStatusLabel.TextColor3 = (kind == "ok") and C.TEXT or C.TEXT_MUTED
end

local _setRunning_ref

local function submitCapturedCode(code)
    if not code or code == "" then return end
    if _seen[code] then return end
    if _submitting then return end
    _seen[code] = true
    task.delay(2, function() _seen[code] = nil end)
    _submitting = true
    _redeemStatus = "redeeming"
    _redeemPendingCode = code; _redeemOriginalCode = code; _redeemStartTime = os.clock()
    CodeDisplayLabel.Text = "Redeeming..."
    setStatus("redeeming: " .. code, "busy")
    local ok, res = submitCodeAdvanced(code)
    _submitting = false
    if ok then setStatus("sent: " .. code, "ok")
    else setStatus("failed: " .. code, "err") end
    running = false
    if _setRunning_ref then _setRunning_ref(false) end
    task.spawn(function()
        local startTime = _redeemStartTime
        task.wait(3)
        if _redeemStatus == "redeeming" and _redeemStartTime == startTime then
            CodeDisplayLabel.Text = "Code Will Show Here"
            _redeemStatus = nil; _redeemPendingCode = nil; _redeemOriginalCode = nil
        end
    end)
end

_G.__ShoxUse = function(code)
    setCodeBoxText(code)
    if autoTypeOn then CodeDisplayLabel.Text = code end
    submitCapturedCode(code)
end

local function captureWord(word)
    if not word or word == "" then return end
    _capturedParts[#_capturedParts + 1] = word
    ProgressLabel.Text = tostring(#_capturedParts) .. "/" .. tostring(getWordCount())
    CodeDisplayLabel.Text = table.concat(_capturedParts)
    if #_capturedParts >= getWordCount() then
        local code = table.concat(_capturedParts)
        _capturedParts = {}
        submitCapturedCode(code)
    end
end

local function detectTrigger(text)
    local lower = text:lower()
    for _, trig in ipairs(TRIGGERS) do
        local s, e = lower:find(trig, 1, true)
        if s then return true, text:sub(e + 1) end
    end
    return false, text
end

local function checkRedeemResponse(text)
    if _redeemStatus ~= "redeeming" then return false end
    local lower = text:lower()
    for _, p in ipairs(SUCCESS_PATTERNS) do
        if lower:find(p, 1, true) then
            _redeemStatus = "success"
            CodeDisplayLabel.Text = "Success Redeem!"
            _redeemPendingCode = nil; _redeemOriginalCode = nil
            return true
        end
    end
    for _, p in ipairs(FAIL_PATTERNS) do
        if lower:find(p, 1, true) then
            _redeemStatus = "failed"
            CodeDisplayLabel.Text = "Failed " .. (_redeemOriginalCode or _redeemPendingCode or "")
            _redeemPendingCode = nil; _redeemOriginalCode = nil
            return true
        end
    end
    return false
end

local function setRunning(value)
    running = value
    if running then
        StartStopFill.BackgroundColor3 = C.ON
        StartStopLabel.TextColor3 = C.TEXT_ON
        StartStopLabel.Text = "ON [F]"
        setStatus("Enabled", "ok")
        ProgressLabel.Text = tostring(#_capturedParts) .. "/" .. tostring(getWordCount())
    else
        StartStopFill.BackgroundColor3 = C.OFF
        StartStopLabel.TextColor3 = C.TEXT
        StartStopLabel.Text = "OFF [F]"
        setStatus("Disabled", nil)
        _capturedParts = {}
        ProgressLabel.Text = "0/" .. tostring(getWordCount())
        if _isSpamming then _isSpamming = false end
    end
end
_setRunning_ref = setRunning

local function processText(text)
    if not text or text == "" then return end
    if checkRedeemResponse(text) then return end
    if isSystemPhrase(text) then return end
    -- Riddle classifier: don't submit riddles as codes
    local kind = classifyDrop(text)
    if kind == "riddle" and duoMode then
        feedAdd(text, nil)
        return
    end
    local triggered, remainder = detectTrigger(text)
    if autoOn and triggered and not running then _setRunning_ref(true) end
    if triggered then
        _redeemStatus = nil; _redeemPendingCode = nil; _redeemOriginalCode = nil
        if _lastBox then pcall(function() _lastBox.Text = "" end) end
        _capturedParts = {}
        CodeDisplayLabel.Text = ""
        for word in remainder:gmatch("[%w_]+") do captureWord(word) end
    else
        if not running then
            if kind == "code" and autoOn then _setRunning_ref(true)
            else feedAdd(text, nil); return end
        end
        for word in text:gmatch("[%w_]+") do captureWord(word) end
    end
    local candidate
    for word in text:gmatch("[%w_]+") do
        if #word >= 4 and (word:match("%u") or word:match("%d")) then candidate = word end
    end
    if triggered then feedAdd(text, candidate) end
end

-- =========================================================================
-- [22] ANTI-RAGDOLL (Physics, from Traced)
-- =========================================================================
local antiRagdoll = {Enabled = false, Connections = {}, Welds = {}, JumpPauseUntil = 0, JumpPauseDuration = 0.6}
local function getRig()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if hum and root and anim then return char, hum, root, anim end
end
local function isJumping(h)
    if tick() < antiRagdoll.JumpPauseUntil then return true end
    if h then
        local st = h:GetState()
        if st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then return true end
    end
    return false
end
local function setStates(h, enabled)
    pcall(function()
        h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, enabled)
        h:SetStateEnabled(Enum.HumanoidStateType.Physics, enabled)
        h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, enabled)
        h:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, enabled)
    end)
end
local function enableAntiRagdoll()
    if antiRagdoll.Enabled then return end
    antiRagdoll.Enabled = true
    local char, h, root = getRig()
    if not char then antiRagdoll.Enabled = false; return end
    setStates(h, false)
    pcall(function()
        h.PlatformStand = false; h.Sit = false; h.AutoRotate = true
    end)
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d ~= root then
            local w = Instance.new("WeldConstraint")
            w.Name = "AntiRagdollWeld"; w.Part0 = root; w.Part1 = d; w.Parent = root
            table.insert(antiRagdoll.Welds, w)
        end
    end
    table.insert(antiRagdoll.Connections, RunService.Stepped:Connect(function()
        if not antiRagdoll.Enabled then return end
        local _, h2, r2 = getRig()
        if h2 and r2 and not isJumping(h2) then
            r2.AssemblyAngularVelocity = Vector3.zero
        end
    end))
    table.insert(antiRagdoll.Connections, RunService.Heartbeat:Connect(function()
        if not antiRagdoll.Enabled then return end
        local c, h2, r2 = getRig()
        if not c or h2.Health <= 0 then return end
        setStates(h2, false)
        local st = h2:GetState()
        local bad = st == Enum.HumanoidStateType.Ragdoll
                 or st == Enum.HumanoidStateType.Physics
                 or st == Enum.HumanoidStateType.FallingDown
                 or st == Enum.HumanoidStateType.PlatformStanding
        if bad or r2.CFrame.UpVector.Y < 0.85 then
            pcall(function()
                h2.PlatformStand = false; h2.Sit = false
                local dir = Vector3.new(r2.CFrame.LookVector.X, 0, r2.CFrame.LookVector.Z)
                if dir.Magnitude > 0.05 then
                    r2.CFrame = r2.CFrame:Lerp(CFrame.lookAt(r2.Position, r2.Position + dir.Unit), 1)
                end
                h2:ChangeState(Enum.HumanoidStateType.GettingUp)
                task.defer(function() if h2.Parent and h2.Health > 0 then h2:ChangeState(Enum.HumanoidStateType.Running) end end)
            end)
        end
    end))
    table.insert(antiRagdoll.Connections, UIS.JumpRequest:Connect(function()
        antiRagdoll.JumpPauseUntil = tick() + antiRagdoll.JumpPauseDuration
    end))
end
local function disableAntiRagdoll()
    antiRagdoll.Enabled = false
    for _, c in ipairs(antiRagdoll.Connections) do pcall(function() c:Disconnect() end) end
    antiRagdoll.Connections = {}
    for _, w in ipairs(antiRagdoll.Welds) do pcall(function() w:Destroy() end) end
    antiRagdoll.Welds = {}
    local _, h = getRig()
    if h then setStates(h, true) end
end

