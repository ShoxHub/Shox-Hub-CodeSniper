-- THEMES
local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function mkTheme(bg, btn, txt, acc, sub)
	return {
		bg = bg,
		btn = btn,
		txt = txt,
		acc = acc,
		sub = sub,
		line = btn:Lerp(acc, 0.35),
		dim = bg:Lerp(C(0, 0, 0), 0.35),
	}
end

local THEMES = {
	Frost = mkTheme(C(10, 22, 40), C(24, 48, 80), C(225, 242, 255), C(120, 200, 255), C(170, 205, 235)),
	Lava = mkTheme(C(20, 8, 6), C(52, 22, 14), C(255, 225, 200), C(255, 100, 20), C(255, 190, 150)),
	Natural = mkTheme(C(10, 24, 14), C(24, 52, 30), C(225, 245, 225), C(90, 200, 90), C(170, 210, 170)),
