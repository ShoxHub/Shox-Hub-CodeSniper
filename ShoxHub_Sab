	local T = CS.Themes[CS.Settings.Theme]
	CS.T = T
	CS.tw(U.main, { BackgroundColor3 = T.bg, BackgroundTransparency = CS.Trans[CS.Settings.Trans] }, 0.3)
	U.stroke.Color = Color3.new(1, 1, 1)
	U.grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, T.accent),
		ColorSequenceKeypoint.new(0.5, T.accent:Lerp(T.bg, 0.75)),
		ColorSequenceKeypoint.new(1, T.accent),
	})
	U.titleBar.BackgroundColor3 = T.panel
	U.title.TextColor3 = T.accent
	U.minBtn.TextColor3 = T.text
	U.closeBtn.TextColor3 = T.text
	for _, btn in ipairs(U.small) do
		btn.BackgroundColor3 = T.panel
		btn.TextColor3 = T.text
	end
	CS.setToggle(U.sniper, "Sniper", CS.Settings.Sniper)
