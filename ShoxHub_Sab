local function rname()
	local t = {}
	for i = 1, 10 do
		t[i] = string.char(math.random(97, 122))
	end
	return table.concat(t)
end

local function viewport()
	local cam = workspace.CurrentCamera
	return (cam and cam.ViewportSize) or Vector2.new(800, 400)
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
end

local function tw(o, p, t, s)
	pcall(function()
		TS:Create(o, TweenInfo.new(t or 0.2, s or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), p):Play()
	end)
end

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function reg(o, prop, key)
	themed[#themed + 1] = { o, prop, key }
	o[prop] = T[key]
	return o
end

local function corner(o, r)
	return mk("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end

local function rgbStr(c)
	return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

-- LOG + STATUS
local logLines = {}

local function log(kind, msg)
	local col
	if kind == "ok" then
		col = "rgb(120,225,130)"
	elseif kind == "warn" then
		col = "rgb(240,200,90)"
	elseif kind == "err" then
		col = "rgb(240,100,100)"
	else
		col = rgbStr(T.txt)
	end
	local text = tostring(msg):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	logLines[#logLines + 1] = '<font color="' .. rgbStr(T.sub) .. '">' .. os.date("%H:%M:%S") .. '</font> <font color="' .. col .. '">' .. text .. "</font>"
	if #logLines > 80 then table.remove(logLines, 1) end
	if U.logText then
		U.logText.Text = table.concat(logLines, "\n")
		task.delay(0.08, function()
			pcall(function()
				U.con.CanvasPosition = Vector2.new(0, 100000)
			end)
		end)
	end
end

local function updateStatus()
	if U.status then
		U.status.Text = "Bereit | Safe Mode " .. (cfg.safe and "AN" or "AUS") .. " | Sniper " .. (cfg.sniper and "AN" or "AUS")
	end
end

