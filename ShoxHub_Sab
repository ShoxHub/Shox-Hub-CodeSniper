CS.on = function(sig, fn)
	local conn = sig:Connect(fn)
	CS.Conn[#CS.Conn + 1] = conn
	return conn
end

CS.isIn = function(input)
	return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
end

CS.rname = function()
	local chars = {}
	for i = 1, 10 do chars[i] = string.char(math.random(97, 122)) end
	return table.concat(chars)
end

CS.load = function()
	pcall(function()
		if isfile and readfile and isfile(CS.File) then
			local data = S.Http:JSONDecode(readfile(CS.File))
			if type(data) == "table" then
				for key, value in pairs(data) do
					if CS.Settings[key] ~= nil and type(value) == type(CS.Settings[key]) then
						CS.Settings[key] = value
					end
				end
			end
		end
	end)
	if not CS.Themes[CS.Settings.Theme] then CS.Settings.Theme = "Frost" end
	if not CS.Scales[CS.Settings.Scale] then CS.Settings.Scale = 2 end
	if not CS.Trans[CS.Settings.Trans] then CS.Settings.Trans = 1 end
	if CS.Settings.Parts < 1 or CS.Settings.Parts > 6 then CS.Settings.Parts = 3 end
	CS.T = CS.Themes[CS.Settings.Theme]
end

CS.save = function()
	pcall(function()
		if writefile then writefile(CS.File, S.Http:JSONEncode(CS.Settings)) end
	end)
end

CS.getParent = function()
	local okHui, hui = pcall(function() return gethui and gethui() end)
	if okHui and hui then return hui end
	local okCore, core = pcall(function() return game:GetService("CoreGui") end)
	if okCore and core then
		local probe = Instance.new("Folder")
		local okSet = pcall(function() probe.Parent = core end)
		probe:Destroy()
		if okSet then return core end
	end
	return S.Players.LocalPlayer:WaitForChild("PlayerGui")
end

CS.tw = function(inst, props, time, style, dir)
	local info = TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out)
	S.Tween:Create(inst, info, props):Play()
end

CS.make = function(class, props, parent)
	local inst = Instance.new(class)
	for key, value in pairs(props) do inst[key] = value end
	if parent then inst.Parent = parent end
	return inst
end

CS.log = function(msg)
	table.insert(CS.Log, os.date("%H:%M:%S") .. "  " .. tostring(msg))
	while #CS.Log > 40 do table.remove(CS.Log, 1) end
	if U.console then
		local first = math.max(1, #CS.Log - 6)
		U.console.Text = table.concat(CS.Log, "\n", first, #CS.Log)
	end
end

CS.row = function(height)
	CS.Order = CS.Order + 1
	return CS.make("Frame", {
		Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1,
		BorderSizePixel = 0, LayoutOrder = CS.Order,
	}, U.content)
end

CS.button = function(parent, text, index, count)
	local gap = 6
	local btn = CS.make("TextButton", {
		Text = text, Position = UDim2.new((index - 1) / count, (index - 1) * gap / count, 0, 0),
		Size = UDim2.new(1 / count, -(count - 1) * gap / count, 1, 0),
		Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, BorderSizePixel = 0,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	CS.make("UICorner", { CornerRadius = UDim.new(0, 9) }, btn)
	CS.make("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, btn)
	local press = CS.make("UIScale", { Scale = 1 }, btn)
	CS.on(btn.InputBegan, function(input)
		if CS.isIn(input) then CS.tw(press, { Scale = 0.94 }, 0.08) end
	end)
	CS.on(btn.InputEnded, function(input)
		if CS.isIn(input) then CS.tw(press, { Scale = 1 }, 0.35, Enum.EasingStyle.Back) end
	end)
	table.insert(U.small, btn)
	return btn
end

CS.setToggle = function(btn, name, state)
	local T = CS.Themes[CS.Settings.Theme]
	btn.Text = name .. ": " .. (state and "ON" or "OFF")
	CS.tw(btn, { BackgroundColor3 = state and T.accent or T.off }, 0.2)
	btn.TextColor3 = state and T.bg or T.text
end

