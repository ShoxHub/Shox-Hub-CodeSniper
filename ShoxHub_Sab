-- Fast path: resolve box, confirm button, callbacks AND their debounce booleans BEFORE the code arrives
local fast
local function collectBools(fn, depth, out)
    if not (fn and getupvalues_ and setupvalue_) then return end
    local ok, ups = pcall(getupvalues_, fn)
    if ok and type(ups) == "table" then
        for k, v in pairs(ups) do
            if type(v) == "boolean" then out[#out + 1] = {fn, k}
            elseif type(v) == "function" and depth > 0 then collectBools(v, depth - 1, out) end
        end
    end
end
local function buildFast()
    if not getconnections_ then return nil end
    local box, confirm = getBox(), getConfirm()
    if not (box and confirm) then return nil end
    local cbs, seenCb = {}, {}
    for _, sig in ipairs({confirm.MouseButton1Click, confirm.Activated}) do
        local ok, list = pcall(getconnections_, sig)
        if ok and type(list) == "table" then
            for _, c in ipairs(list) do
                if c.Enabled ~= false then
                    local cb
                    pcall(function() cb = c.Function end)
                    if cb and not seenCb[cb] then
                        seenCb[cb] = true
                        local bools = {}
                        collectBools(cb, 1, bools)
                        cbs[#cbs + 1] = {cb = cb, bools = bools}
                    end
                end
            end
        end
    end
    if #cbs == 0 then return nil end
    fast = {box = box, confirm = confirm, cbs = cbs}
    return fast
end

local function prewarmSubmit()
    task.spawn(function() pcall(buildFast) end)
end

local function submitOnce(text)
    if not (fast and fast.box.Parent and fast.confirm.Parent) then pcall(buildFast) end
    if fast and fast.box.Parent and fast.confirm.Parent then
        local f = fast
        if f.box.Text ~= text then pcall(function() f.box.Text = text end) end
        for _, e in ipairs(f.cbs) do
            local bl = e.bools
            for i = 1, #bl do pcall(setupvalue_, bl[i][1], bl[i][2], false) end
            task.spawn(e.cb)
        end
        return true, "submitted"
    end
    local box = getBox()
    if not box then return false, "code box not found" end
    if box.Text ~= text then pcall(function() box.Text = text end) end

    if getconnections_ then
        local confirm = getConfirm()
        local ok = false
        if confirm then
            local a = fireConnections(confirm.MouseButton1Click)
            local b = fireConnections(confirm.Activated)
            ok = a or b or false
        end
        if not ok then
            ok = fireConnections(box.FocusLost, true) or ok
        end
        if not ok and firesignal_ and confirm then
            ok = (pcall(firesignal_, confirm.MouseButton1Click)) or (pcall(firesignal_, confirm.Activated))
        end
        return ok, ok and "submitted" or "no submit control"
    end

    -- no getconnections: classic focus release
    if not pcall(function() box:CaptureFocus() end) then return false, "focus failed" end
    task.wait(0.03)
    local ok = pcall(function() box:ReleaseFocus(true) end)
    return ok, ok and "submitted" or "release failed"
end

-- never throws, never hangs the pipeline
local function submitCodeAdvanced(text)
    if type(text) ~= "string" or text == "" then return false, "empty" end
    S.lastSubmitAt = os.clock()
    if S.onRedeem then task.defer(S.onRedeem, text) end
    local okCall, ok, msg = pcall(submitOnce, text)
    if not okCall then return false, tostring(ok) end
    return ok, msg
end

