	U.size.Text = "Size: " .. CS.ScaleNames[CS.Settings.Scale]
	U.theme.Text = "Theme: " .. CS.Settings.Theme
	U.intro.Text = "Intro: " .. (CS.Settings.Intro and "ON" or "OFF")
	U.console.BackgroundColor3 = T.panel
	U.console.TextColor3 = T.text
	U.status.TextColor3 = T.sub
	U.manual.BackgroundColor3 = T.panel
	U.manual.TextColor3 = T.text
	U.manual.PlaceholderColor3 = T.sub
	for _, entry in ipairs(U.ddItems) do
		local selected = entry[3] == CS.Settings.Theme
		CS.tw(entry[2], { Thickness = selected and 3 or 1 }, 0.3)
	end
	U.fab.BackgroundColor3 = T.accent
	U.fab.BackgroundTransparency = CS.Trans[CS.Settings.Trans]
	U.fab.TextColor3 = T.bg
	U.fabStroke.Color = T.text
	CS.updateStatus()
end

CS.DDH = math.ceil(#CS.ThemeOrder / 2) * 32 + 8

CS.setDD = function(open)
	CS.ddOpen = open
	CS.tw(U.dd, { Size = UDim2.new(1, 0, 0, open and CS.DDH or 0) }, open and 0.5 or 0.3)
	for i, entry in ipairs(U.ddItems) do
		local item, stroke = entry[1], entry[2]
		if open then
			item.BackgroundTransparency = 1
			item.TextTransparency = 1
			stroke.Transparency = 1
		end
		task.delay(open and i * 0.05 or 0, function()
			if not CS.Running then return end
			local value = open and 0 or 1
			CS.tw(item, { BackgroundTransparency = value, TextTransparency = value }, 0.3)
			CS.tw(stroke, { Transparency = value }, 0.3)
		end)
	end
end

CS.drag = function(handle, target, onTap)
	local dragging, moved, startPoint, startPos = false, false, nil, nil
	CS.on(handle.InputBegan, function(input)
		if CS.isIn(input) then
			dragging, moved = true, false
			startPoint, startPos = input.Position, target.Position
		end
	end)
	CS.on(handle.InputEnded, function(input)
		if CS.isIn(input) and dragging then
			dragging = false
			if onTap and not moved then onTap() end
		end
	end)
	CS.on(S.UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - startPoint
			if delta.Magnitude > 6 then moved = true end
			if moved then
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end
	end)
end

CS.setOpen = function(open)
	CS.Open = open
	CS.Token = CS.Token + 1
	local myToken = CS.Token
	local base = CS.Scales[CS.Settings.Scale]
	if open then
		U.fab.Visible = false
		U.main.Visible = true
		U.scale.Scale = base * 0.85
		CS.tw(U.scale, { Scale = base }, 0.28, Enum.EasingStyle.Back)
	else
		CS.tw(U.scale, { Scale = base * 0.85 }, 0.18)
		task.delay(0.18, function()
			if CS.Running and CS.Token == myToken then
				U.main.Visible = false
				U.fab.Visible = true
			end
		end)
	end
end

-- Intro (1:1 from Shox Hub). The GUI shows instantly, the beat timeline starts when the sound plays.
CS.introFx = function(snd)
	local T = CS.T
	local mk, tw, RS = CS.make, CS.tw, S.RS
	local ig = mk("ScreenGui", { ResetOnSpawn = false, IgnoreGuiInset = true, Name = CS.rname(), DisplayOrder = 999 }, CS.getParent())
	pcall(function() if syn and syn.protect_gui then syn.protect_gui(ig) end end)
	CS.introG = ig
	local vp = workspace.CurrentCamera.ViewportSize
	local base = math.clamp(math.min(vp.X * 0.6 / 376, vp.Y * 0.4 / 80), 0.5, 3)
	local bg = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.bg, BackgroundTransparency = 1, BorderSizePixel = 0 }, ig)
	tw(bg, { BackgroundTransparency = 0 }, 0.3)
	local stage = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, ig)
	local sc = mk("UIScale", { Scale = base }, stage)
	local L = {}
	for i, ch in ipairs(CS.LET) do
		local x = -163 + (i - 1) * 50 + (i >= 5 and 26 or 0)
		local w = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, x, 0.5, -10), Size = UDim2.fromOffset(50, 80), BackgroundTransparency = 1, BorderSizePixel = 0 }, stage)
		local us = mk("UIScale", { Scale = 1 }, w)
		local lb = mk("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = ch, Font = Enum.Font.GothamBlack, TextSize = 76, TextColor3 = T.accent, TextTransparency = 1 }, w)
		L[i] = { w = w, us = us, lb = lb, x = x, hit = -10, amp = 0, rev = math.huge }
	end
	local line = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 52), Size = UDim2.fromOffset(0, 4), BackgroundColor3 = T.accent, BorderSizePixel = 0 }, stage)
	local sub = mk("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 80), Size = UDim2.fromOffset(376, 22), BackgroundTransparency = 1, Text = CS.Discord, Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = T.sub, TextTransparency = 1 }, stage)
	local fl = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.accent, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, ig)
	local skip = mk("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(78, 32), BackgroundColor3 = T.panel, Text = "Skip", TextColor3 = T.text, Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 10 }, ig)
	mk("UICorner", { CornerRadius = UDim.new(0, 9) }, skip)
	local skS = mk("UIStroke", { Color = T.accent, Thickness = 1, Transparency = 0.55, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, skip)
	local skU = mk("UIScale", { Scale = 1 }, skip)
	CS.on(skip.InputBegan, function(x) if CS.isIn(x) then tw(skU, { Scale = 0.93 }, 0.08) end end)
	CS.on(skip.InputEnded, function(x) if CS.isIn(x) then tw(skU, { Scale = 1 }, 0.3, Enum.EasingStyle.Back) end end)
	local function spark(n, wide)
		for _ = 1, n do
			local a = math.random() * math.pi * 2
			local d = (wide and 260 or 130) * (0.4 + math.random() * 0.8)
			local sx = L[math.random(1, #L)].x
			local p = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, sx, 0.5, -10), Size = UDim2.fromOffset(6, 6), Rotation = math.random(0, 90), BackgroundColor3 = T.accent, BorderSizePixel = 0 }, stage)
			tw(p, { Position = UDim2.new(0.5, sx + math.cos(a) * d, 0.5, -10 + math.sin(a) * d), BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 2) }, 0.55)
			task.delay(0.6, function() p:Destroy() end)
		end
	end
	local function ring(th)
		local r = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -10), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, BorderSizePixel = 0 }, stage)
		mk("UICorner", { CornerRadius = UDim.new(1, 0) }, r)
		local sk = mk("UIStroke", { Thickness = th, Color = T.accent }, r)
		tw(r, { Size = UDim2.fromOffset(820, 820) }, 0.7)
		tw(sk, { Transparency = 1 }, 0.7)
		task.delay(0.8, function() r:Destroy() end)
	end
	local tl, bi, pulse, shake, flashA, ul, subA = 0, 1, 0, 0, 0, 0, 0
	local done, hb, started = false, nil, false
	local t0 = os.clock()
	local function finish(stop)
		if done then return end
		done = true
		if hb then hb:Disconnect() end
		if CS.introHeartbeat == hb then CS.introHeartbeat = nil end
		if stop then
			pcall(function() snd:Stop() snd:Destroy() end)
		else
			pcall(function()
				CS.Tween:Create(snd, TweenInfo.new(0.4), { Volume = 0 }):Play()
			end)
			task.delay(0.45, function()
				pcall(function() snd:Stop() snd:Destroy() end)
			end)
		end
		if CS.introS == snd then CS.introS = nil end
		if CS.introG == ig then CS.introG = nil end
		ig:Destroy()
	end
	local function fire(b)
		local s, kind = b[2], b[3]
		pulse = math.max(pulse, 0.05 + 0.06 * s)
		shake = math.max(shake, 6 * s)
		flashA = math.max(flashA, math.min(0.1 * s, 0.35))
		local a, z, amp = 1, #L, 0.3 * s
		if kind == "a" then a, z, amp = 1, 4, 1.6 elseif kind == "b" then a, z, amp = 5, 7, 1.6 end
		for i = a, z do
			local e = L[i]
			e.hit = tl + (i - a) * 0.035
			e.amp = amp
			if amp > 1 then e.rev = e.hit end
		end
		if kind == "drop" then
			pulse = 0.35 shake = 26 flashA = 0.75
			ring(6) task.delay(0.12, function() ring(3) end)
			spark(24, true)
		elseif kind == "end" then
			pulse = 0.3 shake = 20 flashA = 0.6
			ring(5) spark(18, true)
		else
			spark(math.floor(4 * s) + 2, false)
		end
	end
	hb = CS.on(RS.Heartbeat, function(dt)
		if done then return end
		if snd.IsPlaying then
			started = true
			tl = snd.TimePosition
		elseif started then
			tl += dt
		else
			if os.clock() - t0 > 8 then
				CS.log("Intro: sound did not start")
				finish(true)
			end
			return
		end
		while CS.BEATS[bi] and tl >= CS.BEATS[bi][1] do fire(CS.BEATS[bi]) bi += 1 end
		local f = math.clamp((tl - CS.FADE0) / (CS.FADE1 - CS.FADE0), 0, 1)
		pulse *= math.exp(-dt * 7) shake *= math.exp(-dt * 9) flashA *= math.exp(-dt * 8)
		local sh = shake > 0.3 and shake or 0
		stage.Position = UDim2.new(0.5, (math.random() - 0.5) * 2 * sh, 0.5, (math.random() - 0.5) * 2 * sh)
		stage.Rotation = (math.random() - 0.5) * 0.3 * sh
		sc.Scale = base * (1 + pulse) * (1 + f * 0.5)
		fl.BackgroundTransparency = 1 - flashA
		bg.BackgroundTransparency = f
		for i, e in ipairs(L) do
			local age = tl - e.hit
			e.lb.TextTransparency = (tl >= e.rev) and f or 1
			local d = age >= 0 and math.exp(-age * 5.5) or 0
			e.w.Position = UDim2.new(0.5, e.x, 0.5, -10 - (age >= 0 and math.abs(math.sin(age * 12)) * 22 * d or 0))
			e.w.Rotation = age >= 0 and math.sin(age * 10) * 7 * d * (i % 2 == 0 and 1 or -1) or 0
			e.us.Scale = 1 + (age >= 0 and e.amp * math.exp(-age * 8) or 0)
		end
		if tl >= 0.84 then ul = math.min(1, ul + dt * 3.5) end
		line.Size = UDim2.fromOffset(376 * ul, 4)
		line.BackgroundTransparency = f
		if tl >= 3.15 then subA = math.min(1, subA + dt * 5) end
		sub.TextTransparency = math.max(1 - subA, f)
		skip.BackgroundTransparency = f
		skip.TextTransparency = f
		skS.Transparency = math.max(0.55, f)
		if tl >= CS.FADE1 then finish(false) end
	end)
	CS.introHeartbeat = hb
	-- Bind Skip only after the heartbeat exists, so an immediate click
	-- cannot leave a newly-created heartbeat connection behind.
	CS.on(skip.MouseButton1Click, function() finish(true) end)
end

CS.findIntro = function()
	for _, ext in ipairs({ "ogg", "mp3" }) do
		local path = CS.MusicDir .. "/intro." .. ext
		local ok, exists = pcall(isfile, path)
		if ok and exists then return path end
	end
end

CS.playIntro = function()
	if not CS.Settings.Intro or CS.introG then return end
	if not (isfile and getcustomasset) then CS.log("Intro: isfile/getcustomasset missing") return end
	local f = CS.findIntro()
	if not f then CS.log("Intro: no file in " .. CS.MusicDir) return end
	local ok, id = pcall(getcustomasset, f)
	if not ok or not id then CS.log("Intro: load error") return end
	local s = Instance.new("Sound")
	s.Volume = 0.2 s.SoundId = id s.Looped = false
	s.Parent = S.Sound
	CS.introS = s
	CS.on(s.Ended, function()
		if CS.introS == s then CS.introS = nil end
		s:Destroy()
	end)
	s:Play()
	CS.introFx(s)
end

CS.audioExt = function(body)
	if type(body) ~= "string" or #body < 1000 then return nil end
	local head = body:sub(1, 4)
	if head == "OggS" then return "ogg" end
	if head:sub(1, 3) == "ID3" or body:byte(1) == 255 then return "mp3" end
end

CS.download = function(url)
	local rq = request or http_request or (syn and syn.request)
	if rq then
		local ok, r = pcall(rq, { Url = url, Method = "GET" })
		if ok and type(r) == "table" then
			CS.log("request status=" .. tostring(r.StatusCode) .. " len=" .. tostring(type(r.Body) == "string" and #r.Body or "-"))
			local ext = CS.audioExt(r.Body)
			if ext then return r.Body, ext end
		else
			CS.log("request error: " .. tostring(r))
		end
	else
		CS.log("no request function")
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok then
		CS.log("HttpGet len=" .. tostring(type(body) == "string" and #body or "-"))
		local ext = CS.audioExt(body)
		if ext then return body, ext end
	else
		CS.log("HttpGet error: " .. tostring(body))
	end
end

CS.ensureIntro = function()
	if not CS.Settings.Intro then return end
	if not (writefile and isfile and readfile and getcustomasset) then CS.log("Executor lacks file functions for intro") return end
	local markerPath = CS.MusicDir .. "/intro.src"
	local okM, marker = pcall(readfile, markerPath)
	local have = CS.findIntro()
	if have and okM and marker == CS.IntroUrl then return end
	CS.log("Intro: downloading song")
	local data, ext
	for attempt = 1, 3 do
		data, ext = CS.download(CS.IntroUrl)
		if data then break end
		CS.log("Intro: attempt " .. attempt .. " failed")
		task.wait(1)
	end
	if not data then
		CS.log("Intro: download failed; keeping existing file if available")
		return
	end
	for _, other in ipairs({ "ogg", "mp3" }) do
		if other ~= ext then pcall(delfile, CS.MusicDir .. "/intro." .. other) end
	end
	local path = CS.MusicDir .. "/intro." .. ext
	local okWrite, err = pcall(writefile, path, data)
	if not okWrite then CS.log("Intro: save failed: " .. tostring(err)) return end
	pcall(writefile, markerPath, CS.IntroUrl)
	CS.log("Intro saved: " .. path)
end

CS.stopIntro = function()
	if CS.introHeartbeat then
		pcall(function() CS.introHeartbeat:Disconnect() end)
		CS.introHeartbeat = nil
	end
	pcall(function() if CS.introS then CS.introS:Stop() CS.introS:Destroy() end end)
	pcall(function() if CS.introG then CS.introG:Destroy() end end)
	CS.introS, CS.introG = nil, nil
end

-- Code Sniper core
CS.clean = function(text)
	text = tostring(text):gsub("<[^>]->", "")
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	return (text)
end

CS.strip = function(text)
	-- Remove surrounding sentence punctuation, but hyphens may be code data.
	text = text:gsub("^[%.,!%?:;\"'%(%)%[%]]+", "")
	text = text:gsub("[%.,!%?:;\"'%(%)%[%]]+$", "")
	return text
end

-- Finds trigger words against their ORIGINAL character positions.
-- Supports case changes and punctuation between words without corrupting offsets.
CS.trigger = function(text)
	local words = {}
	for first, word, after in text:gmatch("()([%w]+)()") do
		words[#words + 1] = { value = word:lower(), first = first, last = after - 1 }
	end
	for _, phrase in ipairs(CS.Triggers) do
		for i = 1, #words - #phrase + 1 do
			local matched = true
			for j = 1, #phrase do
				if words[i + j - 1].value ~= phrase[j] then matched = false break end
			end
			if matched then return text:sub(words[i + #phrase - 1].last + 1) end
		end
	end
	return nil
end

CS.findBox = function()
	local pg = S.Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end
	if CS.Box and CS.Box.Parent and CS.Box:IsDescendantOf(pg) then return CS.Box end

	local knownPaths = {
		{ "Codes", "Codes", "CodeRedeem", "TextBox" },
		{ "Codes", "CodeRedeem", "TextBox" },
		{ "RedeemCode", "TextBox" },
		{ "CodeFrame", "TextBox" },
		{ "PromoCode", "TextBox" },
		{ "CodeGUI", "Frame", "TextBox" },
	}
	local box
	for _, pathParts in ipairs(knownPaths) do
		local current = pg
		for _, name in ipairs(pathParts) do
			current = current and current:FindFirstChild(name)
		end
		if current and current:IsA("TextBox") then
			box = current
			break
		end
	end

	-- One fallback scan on cache miss; avoid broad "code" matches in chat inputs.
	if not box then
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("TextBox") then
				local path = d:GetFullName():lower()
				local hint = (d.PlaceholderText or ""):lower():match("^%s*(.-)%s*$")
				local blocked = path:find("chat", 1, true) or path:find("message", 1, true)
				local relevantPath = path:find("redeem", 1, true)
					or path:find("codeinput", 1, true)
					or path:find("promocode", 1, true)
				local relevantHint = hint == "code" or hint == "enter code" or hint == "redeem code"
				if not blocked and (relevantPath or relevantHint) then
					box = d
					break
				end
			end
		end
	end

	CS.Box = box
	CS.Btn = nil
	if box then
		local cachedBox = box
		pcall(function()
			box.Destroying:Connect(function()
				if CS.Box == cachedBox then
					CS.Box = nil
					CS.Btn = nil
				end
			end)
		end)
	end
	return box
end

CS.findSubmit = function(box)
	if not (box and box.Parent) then return nil end
	local function normalize(value)
		return tostring(value or ""):lower():gsub("%s+", " ")
			:gsub("^%s+", ""):gsub("%s+$", ""):gsub("[%.,!%?:;]+$", "")
	end
	local accepted = {
		redeem = true, submit = true, ["redeem code"] = true,
		["submit code"] = true, claim = true, enter = true,
		["enter code"] = true, confirm = true, ["redeem button"] = true,
		["submit button"] = true,
	}
	local function exactMatch(d)
		if not d:IsA("GuiButton") or not d.Visible or not d.Active then return false end
		local name = normalize(d.Name)
		local label = d:IsA("TextButton") and normalize(d.Text) or ""
		local combined = name .. " " .. label
		for _, blocked in ipairs({ "gift", "support", "ticket", "battle", "reward", "purchase", "checkout", "trade" }) do
			if combined:find(blocked, 1, true) then return false end
		end
		return accepted[name] == true or accepted[label] == true
	end

	-- Search nearby UI containers, including nested button frames, and choose
	-- the closest exact-label match rather than the first broad keyword match.
	local boxCenter = box.AbsolutePosition + box.AbsoluteSize / 2
	local best, bestDist = nil, 400
	local scope = box.Parent
	for _ = 1, 3 do
		if not scope or scope:IsA("PlayerGui") then break end
		for _, d in ipairs(scope:GetDescendants()) do
			if exactMatch(d) then
				local ok, dist = pcall(function()
					local center = d.AbsolutePosition + d.AbsoluteSize / 2
					return (center - boxCenter).Magnitude
				end)
				if ok and dist < bestDist then
					best, bestDist = d, dist
				end
			end
		end
		scope = scope.Parent
	end
	if best then
		CS.log("Redeem button candidate: " .. best:GetFullName())
	end
	return best
end

-- Keeps the code box and submit button cached so a submit needs no searching
CS.prime = function()
	local box = CS.findBox()
	if box and not (CS.Btn and CS.Btn.Parent) then
		CS.Btn = CS.findSubmit(box)
	end
end

-- Use Roblox's public GuiButton:Activate() API; no private executor signal hooks.
CS.press = function(btn)
	if not (btn and btn.Parent and btn:IsA("GuiButton")) then return false end
	local okState, interactable = pcall(function()
		return btn.Visible and btn.Active and btn.Interactable
	end)
	if not okState or not interactable then return false end
	local ok = pcall(function() btn:Activate() end)
	return ok
end

CS.redeem = function(code, submit)
	local box = CS.findBox()
	if not box then return false, "code TextBox not found" end
	local focused
	pcall(function() focused = S.UIS:GetFocusedTextBox() end)
	if focused == box then
		return false, "user is typing in code box; entry left untouched"
	end
	box.Text = code
	local verified = false
	pcall(function() verified = box.Text == code end)
	if not verified then
		return false, "text box rejected the code (validator or input restriction)"
	end
	if not submit then return true, "typed" end
	local btn = CS.Btn
	if not (btn and btn.Parent) then
		btn = CS.findSubmit(box)
		CS.Btn = btn
	end
	if btn and CS.press(btn) then
		return true, "unverified", "activation requested on " .. btn.Name .. "; game acceptance not confirmed"
	end
	return true, "typed", "code entered; button activation unavailable; click Redeem manually"
end

-- Runs instantly in the same frame (no task.spawn, no wait)
CS.submit = function(code, source, force)
	code = tostring(code or ""):gsub("%s+", "")
	if code == "" then return end
	local now = os.clock()
	local live = not CS.Settings.SafeMode
	-- Manual submit intentionally bypasses the 30 s automatic Recent guard;
	-- it still has a separate 2 s click throttle.
	if force then
		CS.ManualLastCode = CS.ManualLastCode or {}
		local lastSame = CS.ManualLastCode[code]
		if lastSame and now - lastSame < 10 then
			CS.log("Same code manual submit throttled (10s)")
			return
		end
		if CS.LastManualAt and now - CS.LastManualAt < 2 then return end
		CS.ManualLastCode[code] = now
		CS.LastManualAt = now
	elseif live and CS.Recent[code] and now - CS.Recent[code] < 30 then
		return
	end
	CS.LastCode = code
	local callOk, succeeded, state, detail = pcall(CS.redeem, code, live)
	if not callOk then
		succeeded, state, detail = false, "error", tostring(succeeded)
	end
	if succeeded and state == "typed" then
		CS.RedeemState = "typed"
	elseif live and succeeded and state == "unverified" then
		CS.RedeemState = "unverified"
	else
		CS.RedeemState = "not-submitted"
	end
	CS.log("Code recognized: " .. code .. " (" .. tostring(source) .. ")")
	if CS.RedeemState == "typed" then
		CS.log("Code entered in the visible game box; redemption not confirmed")
	elseif CS.RedeemState == "unverified" then
		CS.log("Redeem activation requested; game acceptance not confirmed")
	else
		CS.log("Code entry/activation unavailable: " .. tostring(detail or state))
	end
	CS.updateStatus()
end

CS.deliver = function(code)
	if CS.Settings.AutoSubmit then
		CS.submit(code, "announcement", false)
	else
		CS.LastCode = code
		CS.RedeemState = "recognized"
		CS.log("Code ready: " .. code .. " (Auto Submit OFF)")
	end
	CS.updateStatus()
end

CS.arm = function(src, firstPiece, sourceElement)
	if #CS.Buffer > 0 then
		CS.log("New trigger discarded " .. #CS.Buffer .. " pending fragment(s)")
	end
	CS.Armed = os.clock()
	CS.ArmSource = sourceElement
	CS.Buffer = {}
	if firstPiece and firstPiece ~= "" then
		table.insert(CS.Buffer, firstPiece)
	end
	CS.FragmentToken = CS.FragmentToken + 1
	local token = CS.FragmentToken
	CS.log("Trigger (" .. tostring(src) .. "): collecting from its source only")
	CS.updateStatus()
	task.delay(CS.FragmentDelays[CS.Settings.FragmentDelay], function()
		if CS.Running and token == CS.FragmentToken and CS.armed() then
			if #CS.Buffer > 0 then
				CS.finishBuffer(token)
			else
				CS.Armed = nil
				CS.ArmSource = nil
				CS.Buffer = {}
				CS.FragmentToken = CS.FragmentToken + 1
				CS.log("Trigger expired without code fragments")
				CS.updateStatus()
			end
		end
	end)
end

-- A fragment is accepted only as a prefix extension from the exact UI label
-- that raised the trigger. Other notifications/chat text cannot enter the buffer.
CS.finishBuffer = function(token)
	if token ~= CS.FragmentToken or not CS.armed() or #CS.Buffer == 0 then return end
	local code = table.concat(CS.Buffer)
	CS.Buffer = {}
	CS.Armed = nil
	CS.ArmSource = nil
	CS.log("Fragments complete: " .. code)
	CS.deliver(code)
end

local STOP_WORDS = {
	to = true, ["for"] = true, redeem = true, now = true, code = true,
	below = true, here = true, please = true, use = true, the = true,
}
CS.onPiece = function(text, src, sourceElement, isPrefixExtension)
	if not CS.Settings.Sniper or not CS.Settings.UseNotify or not CS.armed() then return end
	if not isPrefixExtension or not sourceElement or sourceElement ~= CS.ArmSource then
		return
	end
	local piece
	for tok in tostring(text):gmatch("[%w_+%-]+") do
		local candidate = CS.strip(tok)
		if candidate ~= "" and #candidate <= 32 and not candidate:match("^%d+$") then
			piece = candidate
			break
		end
	end
	if not piece then return end
	table.insert(CS.Buffer, piece)
	CS.Armed = os.clock()
	CS.FragmentToken = CS.FragmentToken + 1
	local token = CS.FragmentToken
	CS.log("Prefix fragment(s) " .. #CS.Buffer .. " (" .. tostring(src) .. "): " .. piece)
	CS.updateStatus()
	task.delay(CS.FragmentDelays[CS.Settings.FragmentDelay], function()
		if CS.Running then CS.finishBuffer(token) end
	end)
end

-- Trigger payloads stop at the first non-prose token; source identity is retained.
CS.onText = function(text, src, sourceElement)
	if not CS.Settings.Sniper or not CS.Settings.UseNotify then return end
	text = CS.clean(text)
	if text == "" then return end
	local now = os.clock()
	if now - CS.SeenT > 60 then
		CS.Seen = {}
		CS.SeenT = now
	end
	if CS.Seen[text] and now - CS.Seen[text] < 0.35 then return end
	CS.Seen[text] = now
	local rest = CS.trigger(text)
	if rest ~= nil then
		local firstCode
		local candidates = {}
		for tok in rest:gmatch("[%w_+%-]+") do
			local candidate = CS.strip(tok)
			if candidate ~= "" then candidates[#candidates + 1] = candidate end
		end
		for _, candidate in ipairs(candidates) do
			if #candidates == 1 or not STOP_WORDS[candidate:lower()] then
				firstCode = candidate
				break
			end
		end
		-- A trigger with no usable payload is not armed. A later typewriter
		-- extension from this same label may start collection in hookGui.
		if not firstCode then
			CS.log("Trigger ignored: no code token in source text")
			return
		end
		CS.arm(src, firstCode, sourceElement)
		return
	end
	-- Non-trigger notifications are never accepted as code fragments.
end

-- Screen text is the only detector source; no remote hooks or introspection.
CS.discover = function()
	if CS.Running then CS.log("Screen-text detector active") end
end

CS.hookGui = function()
	local pg = S.Players.LocalPlayer:FindFirstChild("PlayerGui") or S.Players.LocalPlayer:WaitForChild("PlayerGui", 10)
	if not pg then return end
	CS.GuiWatched = CS.GuiWatched or setmetatable({}, { __mode = "k" })
	CS.GuiConnections = CS.GuiConnections or setmetatable({}, { __mode = "k" })

	local function bindText(d, isInitial)
		if not (d:IsA("TextLabel") or d:IsA("TextButton")) then return end
		if CS.GuiWatched[d] then return end
		if U.gui and d:IsDescendantOf(U.gui) then return end
		if CS.introG and d:IsDescendantOf(CS.introG) then return end
		local path = d:GetFullName():lower()
		if path:find("prompt", 1, true) then return end
		local blockTerms = { "chat", "killfeed", "leaderboard", "playername", "scoreboard", "friend", "tradereq" }
		for _, term in ipairs(blockTerms) do
			if path:find(term, 1, true) then return end
		end
		local watchTerms = { "notification", "notif", "toast", "alert", "message", "announce", "popup", "banner" }
		local relevant = false
		for _, term in ipairs(watchTerms) do
			if path:find(term, 1, true) then relevant = true break end
		end
		if not relevant then return end
		CS.GuiWatched[d] = true

		local version, previous, lastScanned, triggerSeen = 0, nil, nil, false
		local scanPending, pendingInitial = false, false
		local triggerResetToken = 0
		local function scheduleTriggerReset()
			triggerResetToken = triggerResetToken + 1
			local resetToken = triggerResetToken
			task.delay(CS.FragmentDelays[CS.Settings.FragmentDelay], function()
				if d.Parent and resetToken == triggerResetToken then
					triggerSeen = false
					previous, lastScanned = nil, nil
					triggerResetToken = triggerResetToken + 1
				end
			end)
		end
		local function check(isInitial)
			if not CS.Settings.Sniper then return end
			-- Observe clears synchronously; a quick clear-and-retype can happen
			-- inside the delayed scan window.
			if CS.clean(d.Text) == "" then
				previous, lastScanned, triggerSeen = nil, nil, false
				triggerResetToken = triggerResetToken + 1
			end
			pendingInitial = pendingInitial or isInitial
			if scanPending then return end
			scanPending = true
			task.delay(0.12, function()
				scanPending = false
				local scanIsInitial = pendingInitial
				pendingInitial = false
				if not CS.Running or not CS.Settings.Sniper or not d.Parent then return end
				local value = CS.clean(d.Text)
				if value == "" then
					previous, lastScanned, triggerSeen = nil, nil, false
					triggerResetToken = triggerResetToken + 1
					return
				end
				if value == lastScanned then return end
				local old = previous
				previous, lastScanned = value, value
				if CS.trigger(value) ~= nil then
					if old and value:sub(1, #old) == old and triggerSeen then
						local suffix = CS.clean(value:sub(#old + 1))
						local first = suffix:match("[%w_+%-]+")
						if first and #first <= 32 and not first:match("^%d+$") then
							if CS.armed() then
								CS.onPiece(first, "screen-update", d, true)
							elseif not STOP_WORDS[first:lower()] then
								CS.arm("screen-update", first, d)
							end
						end
						scheduleTriggerReset()
					else
						triggerSeen = true
						CS.onText(value, "screen", d)
						scheduleTriggerReset()
					end
					return
				end
				if old and value:sub(1, #old) == old and triggerSeen then
					local suffix = CS.clean(value:sub(#old + 1))
					local first = suffix:match("[%w_+%-]+")
					if first and #first <= 32 and not first:match("^%d+$") then
						if CS.armed() then
							CS.onPiece(first, "screen-update", d, true)
						elseif not STOP_WORDS[first:lower()] then
							CS.arm("screen-update", first, d)
						end
					end
					scheduleTriggerReset()
				elseif not scanIsInitial or CS.armed() then
					CS.onText(value, "screen", d)
					if triggerSeen then scheduleTriggerReset() end
				end
			end)
		end

		-- Existing unrelated UI text is ignored until a trigger arms the detector.
		check(isInitial == true)
		local conn = d:GetPropertyChangedSignal("Text"):Connect(function() check(false) end)
		CS.GuiConnections[d] = conn
	end

	for _, d in ipairs(pg:GetDescendants()) do bindText(d, true) end
	CS.on(pg.DescendantAdded, function(d) bindText(d, false) end)
end

CS.stop = function()
	if not CS.Running then return end
	CS.Running = false
	CS.Armed = nil
	CS.ArmSource = nil
	CS.Buffer = {}
	pcall(CS.save)
	CS.stopIntro()
	for _, conn in ipairs(CS.Conn) do pcall(function() conn:Disconnect() end) end
	if CS.GuiConnections then
		for _, conn in pairs(CS.GuiConnections) do pcall(function() conn:Disconnect() end) end
		CS.GuiConnections = nil
	end
	pcall(function() U.gui:Destroy() end)
	env.CodeSniperStop = nil
end

