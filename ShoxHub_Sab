-- =========================================================================
local function stripTags(s)
    if type(s) ~= "string" then return tostring(s) end
    return (s:gsub("<[^>]->", ""))
end

local function remoteInstancesOf(func)
    local out = {}
    if not getupvalues_ then return out end
    local ok, ups = pcall(getupvalues_, func)
    if ok and type(ups) == "table" then
        for _, v in pairs(ups) do
            if typeof(v) == "Instance" and (v:IsA("RemoteEvent") or v:IsA("UnreliableRemoteEvent"))
                and v.Parent and v.Parent.Name == "Net" then
                out[#out + 1] = v
            end
        end
    end
    return out
end

local function findNotificationRemote()
    if _G.PhiNotifyRemote and _G.PhiNotifyRemote.Parent then return _G.PhiNotifyRemote end
    local ok, mod = pcall(function()
        local controllers = ReplicatedStorage:FindFirstChild("Controllers")
        local ctl = controllers and controllers:FindFirstChild("NotificationController", true)
        return ctl and require(ctl)
    end)
    if ok and type(mod) == "table" and type(mod.Start) == "function" then
        local r = remoteInstancesOf(mod.Start)[1]
        if r then _G.PhiNotifyRemote = r; return r end
    end
    return nil
end

local function clearBooleans(fn, depth)
    if not (fn and setupvalue_ and getupvalues_) then return end
    depth = depth or 1
    local ok, ups = pcall(getupvalues_, fn)
    if ok and type(ups) == "table" then
        for k, v in pairs(ups) do
            if type(v) == "boolean" then pcall(setupvalue_, fn, k, false)
            elseif type(v) == "function" and depth > 0 then clearBooleans(v, depth - 1) end
        end
    end
end

local function fireConnections(signal, ...)
    if not getconnections_ then return false end
    local ok, conns = pcall(getconnections_, signal)
    if not ok or type(conns) ~= "table" or #conns == 0 then return false end
    local args = table.pack(...)
    local any = false
    for _, c in ipairs(conns) do
        if c.Enabled ~= false then
            local cb
            pcall(function() cb = c.Function end)
            clearBooleans(cb)
            local ok2
            if cb then ok2 = pcall(task.spawn, cb, table.unpack(args, 1, args.n))
            else ok2 = pcall(function() c:Fire(table.unpack(args, 1, args.n)) end) end
            any = any or ok2
        end
    end
    return any
end

local function findCodeBox()
    local codes = playerGui:FindFirstChild("Codes")
    if not codes then return nil end
    local redeem = codes:FindFirstChild("CodeRedeem", true)
    if redeem then
        if redeem:IsA("TextBox") then return redeem end
        local tb = redeem:FindFirstChildWhichIsA("TextBox", true)
        if tb then return tb end
    end
    return codes:FindFirstChildWhichIsA("TextBox", true)
end

local function findConfirmButton()
    local codes = playerGui:FindFirstChild("Codes")
    if not codes then return nil end
    for _, d in ipairs(codes:GetDescendants()) do
        if d:IsA("ImageButton") or d:IsA("TextButton") then
            local n = d.Name:lower()
            local t = d:IsA("TextButton") and d.Text:lower() or ""
            if n:find("submit") or n:find("confirm") or n:find("redeem") or n:find("enter") or t:find("submit") then
                return d
            end
        end
    end
    return nil
end

local function submitCodeAdvanced(text)
    if type(text) ~= "string" or text == "" then return false, "empty" end
    local box = findCodeBox()
    if not box then return false, "no code box" end
    pcall(function() box.Text = text; box.Active = true; box.Selectable = true end)
    local confirm = findConfirmButton()
    if confirm then
        local fired = fireConnections(confirm.MouseButton1Click)
        if not fired then fired = fireConnections(confirm.Activated) end
        if fired then return true, "submitted" end
    end
    if fireConnections(box.FocusLost, true) then return true, "submitted (focus)" end
    pcall(function() box:CaptureFocus() end)
    task.wait(0.05)
    pcall(function() box:ReleaseFocus(true) end)
    return true, "submitted (release)"
end

