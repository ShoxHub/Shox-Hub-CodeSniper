-- LAYOUT (Skalierung, Minimieren, im Bild halten)
local function layout()
	local v = viewport()
	local s = math.clamp(v.Y / 470, 0.72, 1)
	local h = cfg.min and HMIN or H
	U.sc.Scale = s
	U.inner.Size = UDim2.fromOffset(W, h)
	U.root.Size = UDim2.fromOffset(W * s, h * s)
	U.body.Visible = not cfg.min
	U.div.Visible = not cfg.min
	U.bMin.Text = cfg.min and "+" or "-"
	local p = U.root.Position
	U.root.Position = UDim2.fromOffset(
		math.clamp(p.X.Offset, -(W * s) + 70, v.X - 70),
		math.clamp(p.Y.Offset, 0, v.Y - 40)
	)
end

local function setOpen(open)
	U.root.Visible = open
	U.fb.Visible = not open
	if open then layout() end
end

-- ZIEHEN (Fenster + Floating Button)
local function makeDrag(handle, target, onTap, onSave)
	local dIn, dStart, dBase = nil, nil, nil
	local moved = false
	on(handle.InputBegan, function(i)
		if isPress(i) then
			dIn = i
			dStart = i.Position
			dBase = target.Position
			moved = false
		end
	end)
	on(UIS.InputChanged, function(i)
		if not dIn then return end
		if dIn.UserInputState == Enum.UserInputState.End or dIn.UserInputState == Enum.UserInputState.Cancel then
			dIn = nil
			return
		end
		local ok = (i == dIn) or (i.UserInputType == Enum.UserInputType.MouseMovement and dIn.UserInputType == Enum.UserInputType.MouseButton1)
		if not ok then return end
		local d = i.Position - dStart
		if not moved and d.Magnitude < 8 then return end
		moved = true
		local v = viewport()
		local sz = target.AbsoluteSize
		target.Position = UDim2.fromOffset(
			math.clamp(dBase.X.Offset + d.X, -sz.X + 70, v.X - 70),
			math.clamp(dBase.Y.Offset + d.Y, 0, v.Y - 40)
		)
	end)
	on(UIS.InputEnded, function(i)
		if dIn and (i == dIn or i.UserInputType == dIn.UserInputType) then
			local wasMoved = moved
			dIn = nil
			if wasMoved then
				if onSave then onSave() end
			elseif onTap then
				onTap()
			end
		end
	end)
end

