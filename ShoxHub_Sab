				cfg.mpos = { tonumber(d.mpos[1]), tonumber(d.mpos[2]) }
			end
		end
	end
end)

local function saveNow()
	pcall(function()
		if writefile then writefile(FILE, HS:JSONEncode(cfg)) end
	end)
end

local saveQueued = false
local function save()
	if saveQueued then return end
	saveQueued = true
	task.delay(0.5, function()
		saveQueued = false
		saveNow()
	end)
end

