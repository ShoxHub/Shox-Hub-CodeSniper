	local function refresh(anim)
		local isOn = cfg[key]
		local pos = isOn and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
		local col = isOn and T.acc or T.line
		if anim then
			tw(pill, { BackgroundColor3 = col }, 0.2)
			tw(dot, { Position = pos, BackgroundColor3 = T.bg }, 0.25, Enum.EasingStyle.Back)
		else
			pill.BackgroundColor3 = col
			dot.Position = pos
			dot.BackgroundColor3 = T.bg
		end
	end
	refreshers[#refreshers + 1] = refresh
	refresh(false)
	on(pill.MouseButton1Click, function()
		cfg[key] = not cfg[key]
		refresh(true)
		updateStatus()
		save()
		onChange(cfg[key])
	end)
	return r
end

