-- =========================================================================
-- [1] INTRO (Shox Hub beat intro)
-- =========================================================================
do
    local ShoxIntro = {
        Running = true,
        Letters = {"S", "H", "O", "X", "H", "U", "B"},
        Beats = {
            {0.05, 1, "a"}, {0.52, 1, "b"}, {0.84, 0.6}, {1.28, 0.9},
            {1.58, 0.5}, {1.88, 0.9}, {2.11, 0.6}, {2.48, 2.2, "drop"},
            {3.15, 1}, {3.74, 1}, {4.34, 1.2}, {4.75, 1.7, "end"},
        },
        IntroUrl = "https://files.catbox.moe/ocdxaf.ogg",
        Dir = "CodeSniper",
        MusicDir = "CodeSniper/music",
    }
    local ShoxIntroGui, ShoxIntroSound, ShoxIntroHeartbeat

    local function introMake(class, props, parent)
        local obj = Instance.new(class)
        for k, v in pairs(props) do obj[k] = v end
        if parent then obj.Parent = parent end
        return obj
    end
    local function introTween(obj, props, duration, style, direction)
        if not obj or not obj.Parent then return nil end
        local t = TweenService:Create(obj, TweenInfo.new(duration or 0.25, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), props)
        t:Play()
        return t
    end
    local function introParent()
        local ok, hui = pcall(function() return gethui and gethui() end)
        if ok and hui then return hui end
        return player:FindFirstChildOfClass("PlayerGui") or game:GetService("CoreGui")
    end
    local function introFinish()
        ShoxIntro.Running = false
        if ShoxIntroHeartbeat then ShoxIntroHeartbeat:Disconnect(); ShoxIntroHeartbeat = nil end
        if ShoxIntroSound then pcall(function() ShoxIntroSound:Stop(); ShoxIntroSound:Destroy() end); ShoxIntroSound = nil end
        if ShoxIntroGui then
            local gui = ShoxIntroGui; ShoxIntroGui = nil
            introTween(gui:FindFirstChild("IntroBG"), {BackgroundTransparency = 1}, 0.25)
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("TextLabel") then introTween(obj, {TextTransparency = 1}, 0.2)
                elseif obj:IsA("Frame") and obj.Name ~= "IntroBG" then introTween(obj, {BackgroundTransparency = 1}, 0.2) end
            end
            task.delay(0.28, function() if gui and gui.Parent then gui:Destroy() end end)
        end
    end
    local function introSpark(stage, letters, count, wide, accent)
        for _ = 1, count do
            local angle = math.random() * math.pi * 2
            local distance = (wide and 260 or 130) * (0.4 + math.random() * 0.8)
            local x = letters[math.random(1, #letters)].x
            local p = introMake("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, x, 0.5, -10),
                Size = UDim2.fromOffset(6, 6), Rotation = math.random(0, 90), BackgroundColor3 = accent, BorderSizePixel = 0}, stage)
            introTween(p, {Position = UDim2.new(0.5, x + math.cos(angle) * distance, 0.5, -10 + math.sin(angle) * distance),
                BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 2)}, 0.55)
            task.delay(0.6, function() if p and p.Parent then p:Destroy() end end)
        end
    end
    local function introRing(stage, accent, thickness)
        local ring = introMake("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -10),
            Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, BorderSizePixel = 0}, stage)
        introMake("UICorner", {CornerRadius = UDim.new(1, 0)}, ring)
        local stroke = introMake("UIStroke", {Thickness = thickness, Color = accent}, ring)
        introTween(ring, {Size = UDim2.fromOffset(820, 820)}, 0.7)
        introTween(stroke, {Transparency = 1}, 0.7)
        task.delay(0.8, function() if ring and ring.Parent then ring:Destroy() end end)
    end
    local function introPlay()
        local accent   = Color3.fromRGB(125, 130, 140)
        local subColor = Color3.fromRGB(190, 200, 215)
        local introParent_ = introParent()
        pcall(function()
            local old = introParent_:FindFirstChild("ShoxHubIntro") or introParent_:FindFirstChild("ShoxCodeSniperIntro")
            if old then old:Destroy() end
        end)
        local gui = introMake("ScreenGui", {Name = "ShoxHubIntro", ResetOnSpawn = false, IgnoreGuiInset = true,
            DisplayOrder = 2000005, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, introParent_)
        pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
        ShoxIntroGui = gui
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
        local base = math.clamp(math.min(viewport.X * 0.6 / 376, viewport.Y * 0.4 / 80), 0.5, 3)
        local bg = introMake("Frame", {Name = "IntroBG", Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(10, 22, 40), BackgroundTransparency = 1, BorderSizePixel = 0, Active = false}, gui)
        introTween(bg, {BackgroundTransparency = 0}, 0.3)
        local stage = introMake("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Active = false}, gui)
        local stageScale = introMake("UIScale", {Scale = base}, stage)
        local letters = {}
        for i, character in ipairs(ShoxIntro.Letters) do
            local x = -163 + (i - 1) * 50 + (i >= 5 and 26 or 0)
            local wrap = introMake("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, x, 0.5, -10),
                Size = UDim2.fromOffset(50, 80), BackgroundTransparency = 1, BorderSizePixel = 0, Active = false}, stage)
            local letterScale = introMake("UIScale", {Scale = 1}, wrap)
            local label = introMake("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                Text = character, Font = Enum.Font.GothamBlack, TextSize = 76, TextColor3 = accent, TextTransparency = 1, Active = false}, wrap)
            letters[i] = {w = wrap, us = letterScale, lb = label, x = x, hit = -10, amp = 0, rev = math.huge}
        end
        local line = introMake("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 52),
            Size = UDim2.fromOffset(0, 4), BackgroundColor3 = accent, BorderSizePixel = 0}, stage)
        local subtitle = introMake("TextLabel", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 80),
            Size = UDim2.fromOffset(376, 22), BackgroundTransparency = 1, Text = "discord.gg/EA7xS26mA9",
            Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = subColor, TextTransparency = 1}, stage)
        local flash = introMake("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = accent,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5, Active = false}, gui)
        local skip = introMake("TextButton", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14),
            Size = UDim2.fromOffset(78, 32), BackgroundColor3 = Color3.fromRGB(24, 48, 80), Text = "Skip",
            TextColor3 = Color3.fromRGB(225, 242, 255), Font = Enum.Font.GothamBold, TextSize = 14,
            AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 10, Active = true}, gui)
        introMake("UICorner", {CornerRadius = UDim.new(0, 9)}, skip)
        introMake("UIStroke", {Color = accent, Thickness = 1, Transparency = 0.55}, skip)
        skip.Activated:Connect(function() introFinish() end)
        local timeline, beatIndex = 0, 1
        local pulse, shake, flashAlpha, underline, subtitleAlpha = 0, 0, 0, 0, 0
        local startedAt = os.clock()
        local audioStarted = false
        local function fireBeat(beat)
            local strength, kind = beat[2], beat[3]
            pulse = math.max(pulse, 0.05 + 0.06 * strength)
            shake = math.max(shake, 6 * strength)
            flashAlpha = math.max(flashAlpha, math.min(0.1 * strength, 0.35))
            local first, last, amplitude = 1, #letters, 0.3 * strength
            if kind == "a" then first, last, amplitude = 1, 4, 1.6
            elseif kind == "b" then first, last, amplitude = 5, 7, 1.6 end
            for i = first, last do
                local e = letters[i]
                e.hit = timeline + (i - first) * 0.035
                e.amp = amplitude
                if amplitude > 1 then e.rev = e.hit end
            end
            if kind == "drop" then
                pulse, shake, flashAlpha = 0.35, 26, 0.75
                introRing(stage, accent, 6)
                task.delay(0.12, function() if ShoxIntro.Running then introRing(stage, accent, 3) end end)
                introSpark(stage, letters, 24, true, accent)
            elseif kind == "end" then
                pulse, shake, flashAlpha = 0.3, 20, 0.6
                introRing(stage, accent, 5)
                introSpark(stage, letters, 18, true, accent)
            else
                introSpark(stage, letters, math.floor(4 * strength) + 2, false, accent)
            end
        end
        local fadeStart, fadeEnd = 4.95, 5.5
        ShoxIntroHeartbeat = RunService.Heartbeat:Connect(function(dt)
            if not ShoxIntro.Running then return end
            local sound = ShoxIntroSound
            if sound and sound.IsPlaying then audioStarted = true; timeline = sound.TimePosition
            elseif audioStarted then timeline = timeline + dt
            else timeline = timeline + dt; if os.clock() - startedAt > 8 then introFinish(); return end end
            while ShoxIntro.Beats[beatIndex] and timeline >= ShoxIntro.Beats[beatIndex][1] do
                fireBeat(ShoxIntro.Beats[beatIndex]); beatIndex = beatIndex + 1
            end
            local fade = math.clamp((timeline - fadeStart) / (fadeEnd - fadeStart), 0, 1)
            pulse = pulse * math.exp(-dt * 7); shake = shake * math.exp(-dt * 9); flashAlpha = flashAlpha * math.exp(-dt * 8)
            local shakeNow = shake > 0.3 and shake or 0
            stage.Position = UDim2.new(0.5, (math.random() - 0.5) * 2 * shakeNow, 0.5, (math.random() - 0.5) * 2 * shakeNow)
            stage.Rotation = (math.random() - 0.5) * 0.3 * shakeNow
            stageScale.Scale = base * (1 + pulse) * (1 + fade * 0.5)
            flash.BackgroundTransparency = 1 - flashAlpha
            bg.BackgroundTransparency = fade
            for i, e in ipairs(letters) do
                local age = timeline - e.hit
                e.lb.TextTransparency = (timeline >= e.rev) and fade or 1
                local damp = age >= 0 and math.exp(-age * 5.5) or 0
                e.w.Position = UDim2.new(0.5, e.x, 0.5, -10 - (age >= 0 and math.abs(math.sin(age * 12)) * 22 * damp or 0))
                e.w.Rotation = age >= 0 and math.sin(age * 10) * 7 * damp * (i % 2 == 0 and 1 or -1) or 0
                e.us.Scale = 1 + (age >= 0 and e.amp * math.exp(-age * 8) or 0)
            end
            if timeline >= 0.84 then underline = math.min(1, underline + dt * 3.5) end
            line.Size = UDim2.fromOffset(376 * underline, 4); line.BackgroundTransparency = fade
            if timeline >= 3.15 then subtitleAlpha = math.min(1, subtitleAlpha + dt * 5) end
            subtitle.TextTransparency = math.max(1 - subtitleAlpha, fade)
            skip.BackgroundTransparency = fade; skip.TextTransparency = fade
            if timeline >= fadeEnd then introFinish() end
        end)
    end
    task.spawn(function()
        pcall(function()
            local folder = ShoxIntro.MusicDir
            if makefolder then makefolder(ShoxIntro.Dir) end
            if makefolder then makefolder(folder) end
            local assetFn = getcustomasset or getsynasset or getasset
            local asset = nil
            if type(assetFn) == "function" and isfile then
                for _, candidate in ipairs({folder .. "/intro.ogg", folder .. "/intro.mp3"}) do
                    local okFile, exists = pcall(isfile, candidate)
                    if okFile and exists then
                        local okAsset, a = pcall(assetFn, candidate)
                        if okAsset and type(a) == "string" then asset = a break end
                    end
                end
            end
            if not asset then
                local body = game:HttpGet(ShoxIntro.IntroUrl)
                if type(body) == "string" and #body > 1000 and writefile and type(assetFn) == "function" then
                    local ext = body:sub(1, 4) == "OggS" and "ogg" or "mp3"
                    local path = folder .. "/intro." .. ext
                    if pcall(writefile, path, body) then
                        local okAsset, a = pcall(assetFn, path)
                        if okAsset and type(a) == "string" then asset = a end
                    end
                end
            end
            if asset and ShoxIntro.Running then
                local sound = Instance.new("Sound")
                sound.Name = "ShoxIntroSound"
                sound.SoundId = asset; sound.Volume = 0.6; sound.Looped = false
                sound.Parent = SoundService; ShoxIntroSound = sound
                pcall(function() sound:Play() end)
            end
        end)
        if ShoxIntro.Running then introPlay() end
    end)
end

