local function processText(text)
    local lower = text:lower()
    local wc = select(2, text:gsub("%S+", ""))

    -- replies to our own submits (invalid / error / success ...) are never code words
    if os.clock() - S.lastSubmitAt < 6 and hasAny(lower, RESP_WORDS) then return end

    if lower:find("?", 1, true) or lower:find("riddle", 1, true) then return end

    local triggered, remainder = detectTrigger(text)
    if triggered then
        if not S.running then
            if not S.autoOn then return end
            setRunning(true)
        end
        S.parts = {}
        UI.codeLabel.Text = ""
        feedWords(remainder)
    else
        if not S.running then return end
        if S.ignoreSystem and (wc >= 4 or (wc >= 2 and hasAny(lower, SYSTEM_WORDS))) then return end
        feedWords(text)
    end
end

