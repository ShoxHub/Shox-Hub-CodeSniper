                corner(b, 8)
                new("UIPadding", {PaddingLeft = UDim.new(0, 12)}, b)
                items[#items + 1] = b
                b.MouseButton1Click:Connect(function()
                    selected = line
                    selBtn.Text = line
                    picker.Visible = false
                end)
            end
            if order % 80 == 0 then task.wait() end
        end
    end
    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q = search.Text:lower()
        for _, b in ipairs(items) do b.Visible = (q == "") or (b.Text:lower():find(q, 1, true) ~= nil) end
        for _, h in ipairs(headers) do h.Visible = (q == "") end
    end)
    closeBtn.MouseButton1Click:Connect(function() picker.Visible = false end)
    selBtn.MouseButton1Click:Connect(function()
        picker.Visible = true
        if not built then task.spawn(build) end
    end)
end

