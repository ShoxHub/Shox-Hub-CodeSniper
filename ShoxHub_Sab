CS.on(S.RS.Heartbeat, function(dt)
	if not CS.Running then return end
	U.grad.Rotation = (U.grad.Rotation + dt * (CS.Settings.Sniper and 90 or 40)) % 360
	local pulse = (math.sin(os.clock() * 4) + 1) / 2
	U.dot.BackgroundTransparency = CS.Settings.Sniper and (0.5 * (1 - pulse)) or 0.4
	CS.Tick = CS.Tick + dt
	if CS.Tick >= 0.5 then
		CS.Tick = 0
		CS.TickN = CS.TickN + 1
		if CS.Settings.Sniper and CS.TickN % 4 == 0 then pcall(CS.prime) end
		if CS.TickN % 60 == 0 then
			local now = os.clock()
			for code, stamp in pairs(CS.Recent) do
				if now - stamp > 60 then CS.Recent[code] = nil end
			end
			for seenText, stamp in pairs(CS.Seen) do
				if now - stamp > 5 then CS.Seen[seenText] = nil end
			end
		end
		CS.updateStatus()
	end
end)

